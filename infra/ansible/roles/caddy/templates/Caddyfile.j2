# Portikus edge configuration — managed by Ansible.
# Caddy terminates TLS with its own internal certificate authority and
# proxies to services that listen on loopback only.

{{ portikus_public_host }} {
	tls internal
	encode gzip

	# Browser-side hardening (SPEC 24.3 and 24.10). frame-ancestors 'none'
	# keeps the control plane out of any iframe, including a preview.
	header {
		Strict-Transport-Security "max-age=31536000"
		Content-Security-Policy "frame-ancestors 'none'"
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
		-Server
	}

	# The control-plane API. The workspace WebSocket lives at
	# /workspaces/<id>/ws, so the /workspaces* block carries it too.
	handle /auth/* {
		reverse_proxy 127.0.0.1:{{ portikus_api_port }}
	}
	handle /workspaces* {
		reverse_proxy 127.0.0.1:{{ portikus_api_port }}
	}
	handle /admin* {
		reverse_proxy 127.0.0.1:{{ portikus_api_port }}
	}
	handle /health {
		reverse_proxy 127.0.0.1:{{ portikus_api_port }}
	}
{% if portikus_mock_idp %}

	# Test identity provider (ADR 0008). Its routes are mounted under this
	# prefix, so the prefix is passed through unchanged.
	handle /mock-idp/* {
		reverse_proxy 127.0.0.1:{{ portikus_mock_idp_port }}
	}
{% else %}

	# The mock provider is off, so nothing under its prefix may fall
	# through to the single-page application and answer 200.
	handle /mock-idp* {
		respond 404
	}
{% endif %}

	# Everything else is the browser bundle; unknown paths fall back to the
	# single-page application entry point.
	handle {
		root * /usr/lib/portikus/web
		try_files {path} /index.html
		file_server
	}
}
