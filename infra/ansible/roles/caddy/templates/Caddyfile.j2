# Portikus edge configuration — managed by Ansible.
# Caddy terminates TLS with its own internal certificate authority and
# proxies to services that listen on loopback only.

# ── Preview edge building blocks ─────────────────────────────────────
# The plain preview path and the multi-port bridge (BROWSER-HANDLING 14)
# run the same steps, so the steps live here once and are imported twice.

# Everything the client said about who it is, thrown away.  The upstream
# may only ever come from the authorization response, so a client copy of
# that header goes too.  Every route on the preview host imports this
# first, including the two that only talk to the API: the API reads
# X-Forwarded-Host to decide which preview host a request is for.
(portikus_forget_forwarded) {
	request_header -X-Portikus-Upstream
	request_header -X-Forwarded-For
	request_header -X-Forwarded-Proto
	request_header -X-Forwarded-Host
	request_header -X-Forwarded-Method
	request_header -X-Forwarded-Uri
}

# Strip forged headers, ask the API, then take the preview session cookie
# out of the request.  Everything a student application must not see is
# removed here, so the two callers cannot forget one.
(portikus_preview_authorize) {
	import portikus_forget_forwarded

	# Every request and every WebSocket upgrade is authorized
	# (BROWSER-HANDLING 10).  Caddy's own proxy fills in the trusted
	# X-Forwarded-Host, -Proto and -For, so the API sees the preview host it
	# must check, alongside the preview cookie and the X-Forwarded-Method and
	# -Uri that forward_auth adds.  The answer carries the internal upstream
	# in X-Portikus-Upstream (ADR 0018).  A non-2xx answer goes back to the
	# browser unchanged, body and status, so the API owns the explanation
	# page.  On the bridge path the URI still carries the reserved prefix, so
	# the API can read the requested port out of X-Forwarded-Uri.
	forward_auth 127.0.0.1:{{ portikus_api_port }} {
		uri /preview/authorize
		copy_headers X-Portikus-Upstream
		# The subrequest is a plain GET.  Without these two lines an upgrade
		# request would ask the API for a WebSocket it never opens, and the
		# authorization would hang.
		header_up -Connection
		header_up -Upgrade
	}

	# The compatibility rewrites below need the workspace address and its
	# port apart.  They come from the authorization answer, never from the
	# request.
	map {http.request.header.X-Portikus-Upstream} {portikus_upstream_host} {portikus_upstream_port} {
		~^(.*):([0-9]+)$ "${1}" "${2}"
		default "" ""
	}

	# BROWSER-HANDLING 16.2: the preview session cookie is Portikus routing
	# state and must not reach the student application.  The pair is cut out
	# of the Cookie header, any cookie the application set for itself stays,
	# and a header left holding nothing is deleted rather than sent empty.
	# The name has to start the header or follow a separator, so a cookie of
	# the application's own whose name merely ends in ours is left alone.
	# One separator goes with the pair; a separator stranded at either end
	# is tidied up afterwards.
	request_header Cookie "(^|;\s*)(__Host-)?portikus-preview=[^;]*" ""
	request_header Cookie "^\s*;\s*" ""
	request_header Cookie ";\s*$" ""
	request_header @portikus_empty_cookie -Cookie
}

# Proxy to the authorized upstream and apply the two narrow compatibility
# rewrites of BROWSER-HANDLING 13.  Nothing else about the response is
# touched: no body rewriting, no header removal, no CORS.  The argument is
# the path prefix a rewritten redirect has to keep: empty on the plain
# preview path, the bridge prefix on the bridge path.
(portikus_preview_proxy) {
	# The upstream placeholder reads the header forward_auth has just copied
	# off the authorization response, never client text.  The header itself
	# is dropped on the way out so the student application never sees the
	# internal address.
	reverse_proxy {http.request.header.X-Portikus-Upstream} {
		header_up -X-Portikus-Upstream

		# A cookie scoped to localhost or to a bare IP address is thrown away
		# by the browser on the preview origin.  Dropping the attribute makes
		# the cookie host-only on the preview origin instead, which is what
		# the application meant.  Only those two shapes are touched: the name
		# has to run to the end of the attribute, so Domain=localhost.evil.example
		# is a real domain and is left as it is.
		header_down Set-Cookie "(?i);\s*domain=(localhost|[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+)\s*(;|$)" "${2}"

		# A redirect the application sends to its own address is the one URL
		# rewrite allowed (BROWSER-HANDLING 13).  Every 3xx is inspected; the
		# new Location is only written when the old one names localhost,
		# 127.0.0.1 or the workspace address on exactly the port this preview
		# serves, so a redirect to another service or another site is passed
		# through untouched.
		@portikus_redirect status 3xx
		handle_response @portikus_redirect {
			# `route` keeps these in the written order, and `defer` applies the
			# new Location after the upstream response headers are copied.
			route {
				# The old Location split into the part that decides
				# (scheme-less authority) and the part that is carried over.
				map {rp.header.Location} {portikus_redirect_origin} {portikus_redirect_tail} {
					~^[a-zA-Z][a-zA-Z0-9+.-]*://([^/]*)(/.*)?$ "${1}" "${2}"
					default "" ""
				}
				# A response matcher cannot read the port out of a placeholder,
				# so the comparison is made here instead.
				@portikus_own_origin expression {portikus_redirect_origin} == "localhost:" + {portikus_upstream_port} || {portikus_redirect_origin} == "127.0.0.1:" + {portikus_upstream_port} || {portikus_redirect_origin} == {portikus_upstream_host} + ":" + {portikus_upstream_port}
				header @portikus_own_origin {
					defer
					Location "https://{http.request.hostport}{args[0]}{portikus_redirect_tail}"
				}
				copy_response
			}
		}
	}
}

https://{{ portikus_public_host }}:{{ portikus_public_port }} {
	tls internal
	encode gzip

	# Browser-side hardening (SPEC 24.3 and 24.10).
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
		-Server
	}
	# frame-ancestors 'none' keeps the control plane out of any iframe,
	# including a preview. /lti/* is the one exception: an LMS may frame the
	# launch, and the API sends a frame-ancestors naming the registered
	# platforms itself (docs/archive/epics/EPIC-13.md, ruling 17).
	@not_lti not path /lti/*
	header @not_lti Content-Security-Policy "frame-ancestors 'none'"

	# The control-plane API. The workspace WebSocket lives at
	# /workspaces/<id>/ws, so the /workspaces* block carries it too.
	handle /auth/* {
		reverse_proxy 127.0.0.1:{{ portikus_api_port }}
	}
	# A browser navigating to a workspace page wants the single-page
	# application, not the API's JSON.  Only document requests are sent to
	# the bundle; fetch, XHR, and WebSocket traffic keeps going to the API.
	# A project download is the exception: the browser navigates to it as a
	# document but the zip comes from the API.
	# The administration screen lives at /admin and its data at /admin/*,
	# so it needs the same split.
	@app_page expression `(path('/workspaces/*') || path('/admin') || path('/admin/')) && !path('*/download') && (header({'Sec-Fetch-Dest': 'document'}) || header({'Accept': 'text/html*'}))`
	handle @app_page {
		root * /usr/lib/portikus/web
		rewrite * /index.html
		file_server
	}
	handle /workspaces* {
		reverse_proxy 127.0.0.1:{{ portikus_api_port }}
	}
	handle /admin* {
		reverse_proxy 127.0.0.1:{{ portikus_api_port }}
	}
	# LTI launch from an LMS (docs/archive/epics/EPIC-13.md). The API answers 404 here
	# when no platform is registered.
	handle /lti/* {
		reverse_proxy 127.0.0.1:{{ portikus_api_port }}
	}
	# An instructor's course list and members (docs/archive/epics/EPIC-13.md, ruling 23).
	# The pages themselves live at /course, served by the bundle below.
	handle /courses* {
		reverse_proxy 127.0.0.1:{{ portikus_api_port }}
	}
	# The first administrator's setup code (docs/archive/epics/EPIC-14.md, rulings 17 and
	# 18). The page itself is /setup, served by the bundle below.
	handle /setup/* {
		reverse_proxy 127.0.0.1:{{ portikus_api_port }}
	}
	# The signed-in user's own editor settings (issue #159).
	handle /me/* {
		reverse_proxy 127.0.0.1:{{ portikus_api_port }}
	}
	handle /health {
		reverse_proxy 127.0.0.1:{{ portikus_api_port }}
	}
{% if portikus_idp == 'dex' %}

	# Dex, the sign-in provider (ADR 0023). It mounts its routes under the
	# issuer's path, so the prefix is passed through unchanged. Dex has no
	# lockout, so every password form post first asks the API's sign-in
	# throttle (#398), and every other /dex/auth request counts as a sign-in
	# start, because Dex keeps each one in memory for ten minutes. A 429 goes
	# back to the browser unchanged.
	handle /dex/* {
		# Only the paths the sign-in flow and the API use reach Dex; the rest,
		# such as the unthrottled /dex/device/code, would store data for nothing.
		# /dex/callback* is for upstream connectors.
		@dex_unused not path /dex/auth* /dex/token /dex/userinfo /dex/keys /dex/.well-known/* /dex/static/* /dex/theme/* /dex/callback*
		# What Dex keeps comes from the URI, so it is capped. The longest real
		# sign-in URI is about 360 bytes.
		@dex_long_uri expression {http.request.uri}.size() > 1024
		# No % in the patterns: Caddy then matches the decoded path, which
		# also catches encoded spellings such as /dex/auth/loc%61l/login.
		# local is Dex's own passwords, ldap the LDAP connector's form.
		@dex_password_post {
			method POST
			path /dex/auth/local/login* /dex/auth/ldap/login*
		}
		# Dex also reads an auth request from a POST body, so /dex/auth takes
		# only GET, apart from the password post.
		@dex_auth_other_method {
			path /dex/auth*
			not method GET
			not {
				method POST
				path /dex/auth/local/login* /dex/auth/ldap/login*
			}
		}
		@dex_signin_start {
			method GET
			path /dex/auth*
		}
		route {
			respond @dex_unused 404
			respond @dex_long_uri 414
			respond @dex_auth_other_method 405
			request_body {
				max_size 16KB
			}
			# Each ask names its scope, so Caddy replaces the client's query
			# instead of passing on a ?scope=start the client added.
			forward_auth @dex_password_post 127.0.0.1:{{ portikus_api_port }} {
				uri /edge/signin-throttle?scope=password
			}
			forward_auth @dex_signin_start 127.0.0.1:{{ portikus_api_port }} {
				uri /edge/signin-throttle?scope=start
			}
			reverse_proxy 127.0.0.1:{{ dex_port }}
		}
	}
{% else %}

	# Dex is off, so nothing under its prefix may fall through to the
	# single-page application and answer 200.
	handle /dex* {
		respond 404
	}
{% endif %}
{% if portikus_idp == 'mock' %}

	# Test identity provider (ADR 0008). Its routes are mounted under this
	# prefix, so the prefix is passed through unchanged.
	handle /mock-idp/* {
		reverse_proxy 127.0.0.1:{{ portikus_mock_idp_port }}
	}
{% else %}

	# The mock provider is off, so nothing under its prefix may fall
	# through to the single-page application and answer 200.
	handle /mock-idp* {
		respond 404
	}
{% endif %}

	# Everything else is the browser bundle; unknown paths fall back to the
	# single-page application entry point.
	handle {
		root * /usr/lib/portikus/web
		try_files {path} /index.html
		file_server
	}
}

# ── Student application preview (BROWSER-HANDLING 7.1, 8, 10, 12, 13,
# 14, 16.2, 16.5) ────────────────────────────────────────────────────
# One wildcard virtual host serves every preview origin
# <workspace-label>-<port>.{{ portikus_preview_suffix }}.  Caddy matches the
# most specific site address, so the application host above is never served
# by this block; site.yml asserts the two can never overlap.
https://*.{{ portikus_preview_suffix }}:{{ portikus_public_port }} {
	tls internal

	# Preview responses belong to the student's application, so Portikus
	# adds no policy headers of its own here.  In particular there is no
	# frame-ancestors directive: the Preview tab embeds these pages
	# (BROWSER-HANDLING 12).  Only Caddy's own banner is removed.
	header {
		-Server
	}

	# BROWSER-HANDLING 16.5: preview access logs must carry no query string
	# (the bootstrap ticket travels in one) and no cookies.
	log {
		output stderr
		format filter {
			wrap json
			fields {
				request>uri regexp "\?.*" ""
				request>headers>Cookie delete
				request>headers>Referer delete
				request>headers>Authorization delete
			}
		}
	}

	# The preview session cookie is cut out of every request below.  This
	# matcher spots a Cookie header the cut has left with nothing in it.
	@portikus_empty_cookie header_regexp Cookie ^$

	# Reserved edge paths.  They are answered before any proxying and never
	# reach the student application (BROWSER-HANDLING 12).
	handle /__portikus/bootstrap {
		route {
			import portikus_forget_forwarded
			reverse_proxy 127.0.0.1:{{ portikus_api_port }}
		}
	}
	handle /__portikus/reset {
		route {
			import portikus_forget_forwarded
			reverse_proxy 127.0.0.1:{{ portikus_api_port }}
		}
	}
	# The same-origin bridge to a second port in the same workspace
	# (BROWSER-HANDLING 14).  The reserved prefix is still on the URI when
	# the API is asked, so the API reads the wanted port out of
	# X-Forwarded-Uri and answers with that port's upstream; the prefix is
	# stripped before the request reaches the application.  Caddy accepts
	# only the shape the API's own parser accepts: a port with no leading
	# zero, followed by a slash.  Anything else is a 404 here rather than a
	# refusal there, so the two never disagree about what a bridge path is.
	handle /__portikus/ports/* {
		route {
			@portikus_bad_bridge not path_regexp ^/__portikus/ports/[1-9][0-9]*/
			respond @portikus_bad_bridge 404

			import portikus_preview_authorize
			uri path_regexp ^/__portikus/ports/[1-9][0-9]*/ /
			import portikus_preview_proxy "/__portikus/ports/{portikus_upstream_port}"
		}
	}
	# Nothing else under the reserved prefix exists.  Answering here keeps
	# the API out of the path entirely.
	handle /__portikus/* {
		respond 404
	}

	# Everything else is student application traffic.  `route` is used
	# instead of bare directives so the steps run in exactly this order:
	# authorize, then proxy.
	handle {
		route {
			import portikus_preview_authorize
			import portikus_preview_proxy ""
		}
	}
}
