# The site certificate, seeded by setup on first install; the admin page's
# root job owns this file from now on (docs/SPEC.md section 21.12).
# The Caddyfile imports the global snippet in its global options, with the
# on-demand ask URL as its argument, and the other two in the site blocks.
{% if portikus_tls == 'letsencrypt' %}
{%   set directive %}
	tls {{ portikus_acme_email }} {
		ca {{ portikus_acme_ca }}
		dns cloudflare {file.{{ caddy_certificate_dir }}/secrets/cloudflare_api_token}
	}
{%   endset %}
{% elif portikus_tls == 'files' %}
{%   set directive %}
	tls {{ caddy_certificate_dir }}/files/site.crt {{ caddy_certificate_dir }}/files/site.key
{%   endset %}
{% else %}
{%   set directive %}
	tls internal
{%   endset %}
{% endif %}
(portikus_tls_global) {
}
(portikus_tls_site) {
{{ directive | trim('\n') }}
}
(portikus_tls_preview) {
{{ directive | trim('\n') }}
}
