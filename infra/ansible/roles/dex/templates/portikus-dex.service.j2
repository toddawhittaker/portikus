# Dex, the Portikus sign-in provider — managed by Ansible (ADR 0023, ADR 0028).
[Unit]
Description=Portikus sign-in provider (Dex)
After=network.target postgresql.service
Wants=postgresql.service
ConditionPathExists={{ dex_config_dir }}/config.yaml

[Service]
Type=simple
User=portikus-dex
Group=portikus-dex
ExecStart=/usr/local/bin/dex serve {{ dex_config_dir }}/config.yaml
{% if portikus_dex_upstream in ['entra', 'google', 'oidc'] %}
# The upstream provider is reached through the egress proxy (ADR 0027).
Environment=HTTPS_PROXY={{ portikus_outbound_proxy_url }}
{% endif %}
# Dex exits 2 when systemd stops it with SIGTERM; that is a clean stop.
SuccessExitStatus=2
Restart=on-failure
RestartSec=5
# Workspaces may together promise more memory than the VM has; when it runs
# out, the kernel kills workspace processes first.  The cap keeps a leak or
# a flood of requests from taking the VM instead (about 30 MiB measured; docs/CAPACITY.md).
OOMScoreAdjust=-900
MemoryMax=256M

# Hardening, the same as the Portikus units (SPEC section 24).
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
# Loopback for the proxy and the database; an LDAP directory by address,
# since LDAP does not go through the proxy (docs/archive/epics/EPIC-14.md ruling 28).
IPAddressAllow=127.0.0.0/8{% if portikus_dex_upstream == 'ldap' %} {{ portikus_ldap_ip_allow | join(' ') }}{% endif %}

IPAddressDeny=any

[Install]
WantedBy=multi-user.target
