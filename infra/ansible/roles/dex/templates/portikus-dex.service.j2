# Dex, the Portikus sign-in provider — managed by Ansible (docs/adr/0023).
[Unit]
Description=Portikus sign-in provider (Dex)
After=network.target
ConditionPathExists={{ dex_config_dir }}/config.yaml

[Service]
Type=simple
User=portikus-dex
Group=portikus-dex
ExecStart=/usr/local/bin/dex serve {{ dex_config_dir }}/config.yaml
# Dex exits 2 when systemd stops it with SIGTERM; that is a clean stop.
SuccessExitStatus=2
Restart=on-failure
RestartSec=5
# Workspaces may together promise more memory than the VM has; when it runs
# out, the kernel kills workspace processes first.  The cap keeps a leak or
# a flood of requests from taking the VM instead (about 30 MiB measured; docs/CAPACITY.md).
OOMScoreAdjust=-900
MemoryMax=256M

# Hardening, the same as the Portikus units (SPEC section 24).
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
IPAddressAllow=127.0.0.0/8
IPAddressDeny=any

[Install]
WantedBy=multi-user.target
