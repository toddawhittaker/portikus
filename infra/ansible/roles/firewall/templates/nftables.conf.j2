#!/usr/sbin/nft -f
# Portikus platform VM firewall (STACK.md section 29).
# Managed by Ansible — do not edit manually.

# Flush only the tables this file owns.  A global "flush ruleset" would
# also remove the "inet incus" table that Incus creates for bridge NAT and
# network ACLs, leaving workspaces without DHCP, DNS, or ACL enforcement
# until the daemon restarts, and the egress helper's "inet portikus_egress",
# which would open allow-list mode.
table inet filter
flush table inet filter
table inet nat
flush table inet nat

table inet filter {

  chain input {
    type filter hook input priority 0; policy drop;

    # Loopback
    iif lo accept

    # Established / related
    ct state established,related accept

    # SSH (management), on the ports `sshd -T` reports — reject from
    # workspace bridge (defense in depth if ACL absent)
{% if firewall_ssh_ports | length > 0 %}
    iifname != "{{ incus_network_name }}" tcp dport { {{ firewall_ssh_ports | join(', ') }} } accept
{% endif %}

    # HTTP/HTTPS — Caddy listens here.  Workspaces must not reach the
    # control-plane site from inside the bridge, so drop those first.
    iifname "{{ incus_network_name }}" tcp dport { 80, {{ portikus_public_port }} } drop
    tcp dport { 80, {{ portikus_public_port }} } accept

    # ICMP / ICMPv6 for diagnostics
    ip protocol icmp accept
    ip6 nexthdr ipv6-icmp accept

    # DHCP and DNS from workspaces to the dnsmasq Incus runs on the bridge
    # gateway.  Every base chain on the input hook must accept a packet,
    # so the allow Incus adds in its own table is not enough on its own.
    iifname "{{ incus_network_name }}" udp dport { 67, 53 } accept
    iifname "{{ incus_network_name }}" tcp dport 53 accept

    # Workspace egress in allow-list mode (ADR 0038): the workspace proxy
    # and our DNS take only connections the redirect in table inet
    # portikus_egress made.  Dialled directly, they stay closed.
    iifname "{{ incus_network_name }}" tcp dport { {{ workspace_egress_http_port }}, {{ workspace_egress_https_port }} } ct status dnat accept
    iifname "{{ incus_network_name }}" meta l4proto { tcp, udp } th dport {{ workspace_egress_dns_port }} ct status dnat accept
  }

  chain forward {
    type filter hook forward priority 0; policy drop;

    # Established / related return traffic
    ct state established,related accept

    # --- Deny rules first (order matters) ---

    # Block workspace traffic to the libvirt management network
    iifname "{{ incus_network_name }}" ip daddr {{ management_cidr }} drop

    # Block workspace traffic to the VM's own management address
    iifname "{{ incus_network_name }}" ip daddr {{ incus_network_cidr | ansible.utils.ipaddr('address') }} drop

    # Block private and special ranges: the host, the LAN, link-local and
    # cloud metadata (SPEC.md 23.2).  Neighbour discovery is never forwarded,
    # so denying fe80::/10 here does not affect it.
{% set denied_v4 = workspace_egress_denied_ranges | ansible.utils.ipv4 | ansible.utils.cidr_merge %}
{% set denied_v6 = workspace_egress_denied_ranges | ansible.utils.ipv6 | ansible.utils.cidr_merge %}
{% if denied_v4 %}
    iifname "{{ incus_network_name }}" ip daddr { {{ denied_v4 | join(', ') }} } drop
{% endif %}
{% if denied_v6 %}
    iifname "{{ incus_network_name }}" ip6 daddr { {{ denied_v6 | join(', ') }} } drop
{% endif %}

    # --- General egress (after all denies) ---
    iifname "{{ incus_network_name }}" accept
  }

  chain output {
    type filter hook output priority 0; policy accept;

    # The worker may open loopback connections only to the controller, so it
    # cannot reach the API or Dex around Caddy's sign-in rate limit (SPEC.md
    # 24.9).  Replies from its own listeners are established and pass.
    oif "lo" meta skuid "portikus-worker" ct state new tcp dport {{ portikus_controller_port }} accept
    oif "lo" meta skuid "portikus-worker" ct state new meta l4proto tcp reject with tcp reset
    oif "lo" meta skuid "portikus-worker" ct state new reject
  }
}

table inet nat {
  chain postrouting {
    type nat hook postrouting priority 100; policy accept;
    # Masquerade workspace traffic leaving via the VM's default uplink.
    # Incus also adds its own masquerade in the "inet incus" table when
    # ipv4.nat is true, but we keep ours so NAT works even if that table
    # is absent (e.g. before the first container starts).
    oifname "{{ ansible_default_ipv4.interface }}" masquerade
  }
}
