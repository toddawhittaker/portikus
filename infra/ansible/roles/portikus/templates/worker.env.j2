# Portikus worker environment — managed by Ansible.
NODE_ENV={{ portikus_node_env }}
LOG_LEVEL={{ portikus_log_level }}
DATABASE_URL={{ portikus_database_url }}
CONTROLLER_URL={{ portikus_controller_url }}
CONTROLLER_TOKEN={{ portikus_controller_token }}
SHUTDOWN_GRACE_SECONDS={{ portikus_shutdown_grace_seconds }}
PRESENCE_TTL_SECONDS={{ portikus_presence_ttl_seconds }}
SWEEP_INTERVAL_SECONDS={{ portikus_sweep_interval_seconds }}
START_TIMEOUT_SECONDS={{ portikus_start_timeout_seconds }}
STOP_TIMEOUT_SECONDS={{ portikus_stop_timeout_seconds }}
STATUS_REFRESH_SECONDS={{ portikus_status_refresh_seconds }}
WORKSPACE_HOME_SIZE_GIB={{ portikus_workspace_home_size_gib }}
WORKSPACE_DOCKER_SIZE_GIB={{ portikus_workspace_docker_size_gib }}
