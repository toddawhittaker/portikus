# Portikus API environment — managed by Ansible.
NODE_ENV={{ portikus_node_env }}
LOG_LEVEL={{ portikus_log_level }}
PORT={{ portikus_api_port }}
DATABASE_URL={{ portikus_database_url }}
PRESENCE_TTL_SECONDS={{ portikus_presence_ttl_seconds }}
WORKSPACE_HOME_SIZE_GIB={{ portikus_workspace_home_size_gib }}
WORKSPACE_DOCKER_SIZE_GIB={{ portikus_workspace_docker_size_gib }}
WORKSPACE_RECOVERY_SIZE_GIB={{ portikus_workspace_recovery_size_gib }}
PUBLIC_URL={{ portikus_public_url }}
# The wildcard namespace Caddy serves student application previews on
# (BROWSER-HANDLING 7.1 and 23).  The port range and ticket lifetime keep
# their defaults from packages/config.
PREVIEW_SUFFIX={{ portikus_preview_suffix }}
OIDC_ISSUER_URL={{ portikus_effective_oidc_issuer }}
OIDC_CLIENT_ID={{ portikus_effective_oidc_client_id }}
OIDC_CLIENT_SECRET={{ portikus_effective_oidc_client_secret }}
OIDC_SCOPES={{ portikus_oidc_scopes }}
OIDC_GROUPS_CLAIM={{ portikus_oidc_groups_claim }}
OIDC_STUDENT_GROUP={{ portikus_oidc_student_group }}
OIDC_ADMIN_GROUP={{ portikus_oidc_admin_group }}
OIDC_INSTRUCTOR_GROUP={{ portikus_oidc_instructor_group }}
# The role of someone no group matches.  Dex decides who may sign in
# (SPEC.md section 5.1).
OIDC_DEFAULT_ROLE={{ portikus_oidc_default_role }}
# The egress proxy (ADR 0027): the LMS keysets' requests go through it,
# because the unit lets the API reach nothing else outside.
OUTBOUND_PROXY_URL={{ portikus_outbound_proxy_url }}
# Dex's gRPC API, for the Users view's Dex accounts (ADR 0028).
DEX_GRPC_ADDR={{ dex_grpc_addr }}
DEX_GRPC_CA={{ dex_grpc_dir }}/ca.crt
DEX_GRPC_CERT={{ dex_grpc_dir }}/client.crt
DEX_GRPC_KEY={{ dex_grpc_dir }}/client.key
# Caddy hands Dex's password posts to the API, which counts them and
# passes them on to Dex here (SPEC.md section 24.13).
DEX_HTTP_URL=http://127.0.0.1:{{ dex_port }}
SESSION_COOKIE_SECRET={{ portikus_session_cookie_secret }}
SECOND_FACTOR_KEY={{ portikus_second_factor_key }}
SESSION_TTL_SECONDS={{ portikus_session_ttl_seconds }}
NODE_EXTRA_CA_CERTS={{ portikus_caddy_root_cert }}
# The admin page's workspace image section writes its requests here for the
# root image job (docs/SPEC.md section 22.4, ADR 0030).
IMAGE_JOBS_DIR={{ portikus_image_jobs_dir }}
# The Docker tab's requests for the root cache helper, and its status file.
REGISTRY_JOBS_DIR={{ portikus_registry_jobs_dir }}
# The Certificate tab's requests for the root certificate job (docs/SPEC.md section 21.12).
CERTIFICATE_JOBS_DIR={{ portikus_certificate_jobs_dir }}
{% if portikus_backup_local | default(false) | bool %}
# The root helper behind the Backups tab's key download and upload (ADR 0044).
# Unset on a VM backed up by a separate host, which holds that key itself.
BACKUP_KEY_SOCKET=/run/portikus-backup-key.sock
{% endif %}
# The root helper behind the Root shell tab (docs/adr/0051-root-shell.md).
# Empty when portikus_root_shell is false: the API refuses shells.
ROOT_SHELL_SOCKET={{ '/run/portikus-root-shell.sock' if portikus_root_shell | bool else '' }}
AGENT_PORT={{ portikus_agent_port }}
# Project templates: name=url,name=url. Empty hides the template option.
PROJECT_TEMPLATES={{ portikus_project_templates | default('') }}
# LTI launch (ADR 0025).  Ansible removes the
# platforms file when none is registered, and a missing file means LTI is off.
LTI_PLATFORMS_FILE={{ portikus_lti_platforms_path }}
LTI_TOOL_KEY_FILE={{ portikus_lti_tool_key_path }}
