# Portikus administrator alert channels — managed by Ansible.  Read by the
# API, the worker and `portikus alert`; empty turns a channel off
# (STACK.md section 15).
ALERT_PUSHOVER_USER_KEY={{ portikus_alert_pushover_user_key }}
ALERT_PUSHOVER_APP_TOKEN={{ portikus_alert_pushover_app_token }}
ALERT_WEBHOOK_URL={{ portikus_alert_webhook_url }}
