# Managed by Ansible (workspace_egress role).  The egress helper's settings
# (ADR 0038); the helper refuses an unknown, repeated or missing key.  The
# denied ranges are the IPv4 half of workspace_egress_denied_ranges.  The
# proxy user id is portikus-wsproxy's, whose DNS lookups the helper sends
# to our dnsmasq.
EGRESS_BRIDGE={{ workspace_egress_bridge }}
EGRESS_GATEWAY={{ workspace_egress_gateway }}
EGRESS_SUBNET={{ workspace_egress_subnet }}
EGRESS_UPSTREAM={{ workspace_egress_upstream }}
EGRESS_COUNTER_DNS_PORT={{ workspace_egress_dns_counter_port }}
EGRESS_DENIED_RANGES={{ workspace_egress_denied_ranges | ansible.utils.ipv4 | join(',') }}
EGRESS_PROXY_UID={{ getent_passwd['portikus-wsproxy'][1] }}
