#!/usr/sbin/nft -f
# Managed by Ansible (workspace_egress role).  Outbound abuse limits for
# workspaces (SPEC.md 24.2), in a table of their own so the firewall's file
# and the egress helper never touch it and it holds in every egress mode.
# portikus-workspace-limits.service loads it, replacing the whole table.
#
# The chain runs before NAT, so a connection the egress helper redirects to
# Squid is still seen with its real destination.  Traffic to the VM itself
# (DNS, the Docker caches) is not limited here; the firewall caps it.
#
# The meters list each workspace by its bridge address:
#   nft list set inet portikus_workspace_limits new_conns    new connections per workspace
#   nft list set inet portikus_workspace_limits conn_over    connections over the limit
#   nft list set inet portikus_workspace_limits packet_over  packets over the limit
# and the log lines carry the prefixes below (journalctl -k --grep portikus-ws-).
{# A connection-mark bit of our own; the egress helper's table uses 0x00200000 (render.test.ts checks). #}
{% set flow_mark = '0x00100000' %}
table inet portikus_workspace_limits
destroy table inet portikus_workspace_limits

table inet portikus_workspace_limits {
	set new_conns {
		type ipv4_addr
		size 65535
		flags dynamic, timeout
		timeout 1h
		counter
	}
	set conn_rate {
		type ipv4_addr
		size 65535
		flags dynamic, timeout
		timeout 1m
	}
	set packet_rate {
		type ipv4_addr
		size 65535
		flags dynamic, timeout
		timeout 1m
	}
	set conn_over {
		type ipv4_addr
		size 65535
		flags dynamic, timeout
		timeout 1h
		counter
	}
	set packet_over {
		type ipv4_addr
		size 65535
		flags dynamic, timeout
		timeout 1h
		counter
	}
	# One log line a minute per workspace and reason, so a flood cannot fill the journal.
	set log_limit {
		type ipv4_addr . inet_service
		size 65535
		flags dynamic, timeout
		timeout 2m
	}
	counter mail_blocked {
	}

	chain prerouting {
		type filter hook prerouting priority mangle; policy accept;
		iifname != "{{ workspace_egress_bridge }}" return
		fib daddr type { local, broadcast, multicast } return
		# Only a flow's first packet: a UDP flow stays "new" until the far end answers.
		ct state new ct mark and {{ flow_mark }} == 0 jump new_flow
		# An established TCP stream needed a handshake the far end agreed to, and the bandwidth cap meters it.
		meta l4proto tcp ct state established return
		update @packet_rate { ip saddr limit rate over {{ workspace_egress_packet_rate }}/second burst {{ workspace_egress_packet_burst }} packets } goto packet_over
	}

	chain new_flow {
		ct mark set ct mark or {{ flow_mark }}
		update @new_conns { ip saddr counter }
{% if not portikus_workspace_mail_allowed | bool %}
		tcp dport { 25, 465, 587 } goto mail
{% endif %}
		update @conn_rate { ip saddr limit rate over {{ workspace_egress_connection_rate }}/second burst {{ workspace_egress_connection_burst }} packets } goto conn_over
	}

	# The port in the log key only separates the three reasons.
	chain mail {
		counter name "mail_blocked"
		update @log_limit { ip saddr . 25 limit rate 1/minute burst 1 packets } limit rate 20/minute log prefix "portikus-ws-mail-blocked: " level warn
		drop
	}
	chain conn_over {
		update @conn_over { ip saddr counter }
		update @log_limit { ip saddr . 1 limit rate 1/minute burst 1 packets } limit rate 20/minute log prefix "portikus-ws-conn-limit: " level warn
		drop
	}
	chain packet_over {
		update @packet_over { ip saddr counter }
		update @log_limit { ip saddr . 2 limit rate 1/minute burst 1 packets } limit rate 20/minute log prefix "portikus-ws-packet-limit: " level warn
		drop
	}
}
