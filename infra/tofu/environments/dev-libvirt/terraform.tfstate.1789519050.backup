{"version":4,"terraform_version":"1.9.0","serial":8,"lineage":"fd542153-4640-ada4-7d2c-eb7cff3bc5d2","outputs":{"management_cidr":{"value":"10.100.0.0/24","type":"string"},"vm_ip":{"value":["10.100.0.22"],"type":["list","string"]}},"resources":[{"module":"module.platform_vm","mode":"managed","type":"libvirt_cloudinit_disk","name":"init","provider":"provider[\"registry.opentofu.org/dmacvicar/libvirt\"]","instances":[{"schema_version":0,"attributes":{"id":"/var/lib/libvirt/images/portikus/portikus-cloudinit.iso;f799ec7f-80ff-4b66-870e-1a8844af9986","meta_data":"","name":"portikus-cloudinit.iso","network_config":"","pool":"portikus","user_data":"#cloud-config\n# Minimal first-boot bootstrap (STACK.md section 21).\n# Sets up just enough for Ansible to take over: a deployment user,\n# SSH key, Python, and a hostname. Full configuration is in Ansible.\n\n# Rendered by OpenTofu with templatefile(); the ${name} values come from\n# infra/tofu/environments/dev-libvirt/terraform.tfvars (git-ignored).\nhostname: portikus\n\n# The deploy user Ansible connects as.\nusers:\n  - name: deploy\n    groups: sudo\n    shell: /bin/bash\n    sudo: ALL=(ALL) NOPASSWD:ALL\n    ssh_authorized_keys:\n      - \"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHVQR0Vn0xfQbVR3lFP2dlfFIigJLE0TTLMk11iX91/Z todd@thewhittakers.org\"\n\n# Ensure Python is available for Ansible.\npackages:\n  - python3\n  - python3-apt\n\npackage_update: true\npackage_upgrade: true\n\n# Disable root SSH login.\nssh_pwauth: false\n\n# Signal completion so the operator can tell when cloud-init is done.\nfinal_message: \"cloud-init finished at $TIMESTAMP — ready for Ansible\"\n"},"sensitive_attributes":[],"private":"bnVsbA==","dependencies":["module.platform_vm.libvirt_pool.portikus"]}]},{"module":"module.platform_vm","mode":"managed","type":"libvirt_domain","name":"vm","provider":"provider[\"registry.opentofu.org/dmacvicar/libvirt\"]","instances":[{"schema_version":0,"attributes":{"arch":"x86_64","autostart":false,"boot_device":[],"cloudinit":"/var/lib/libvirt/images/portikus/portikus-cloudinit.iso;f799ec7f-80ff-4b66-870e-1a8844af9986","cmdline":[],"console":[{"source_host":"127.0.0.1","source_path":"","source_service":"0","target_port":"0","target_type":"serial","type":"pty"}],"coreos_ignition":null,"cpu":[{"mode":"host-passthrough"}],"description":"","disk":[{"block_device":"","file":"","scsi":false,"url":"","volume_id":"/var/lib/libvirt/images/portikus/portikus-os.qcow2","wwn":""},{"block_device":"","file":"","scsi":false,"url":"","volume_id":"/var/lib/libvirt/images/portikus/portikus-data.qcow2","wwn":""}],"emulator":"/usr/bin/qemu-system-x86_64","filesystem":[],"firmware":null,"fw_cfg_name":"opt/com.coreos/config","graphics":[{"autoport":true,"listen_address":"127.0.0.1","listen_type":"none","type":"vnc","websocket":0}],"id":"c5c4b142-40ec-44c3-a57b-a23cdb585cce","initrd":"","kernel":"","machine":"pc","memory":8192,"metadata":null,"name":"portikus","network_interface":[{"addresses":["10.100.0.22"],"bridge":"","hostname":"portikus","mac":"52:54:00:82:30:3A","macvtap":"","network_id":"167925ba-a821-436d-a5b3-68bc66f9cb74","network_name":"portikus","passthrough":"","private":"","vepa":"","wait_for_lease":true}],"nvram":[],"qemu_agent":false,"running":true,"timeouts":null,"tpm":[],"type":"kvm","vcpu":4,"video":[],"xml":[{"xslt":"\u003c?xml version=\"1.0\"?\u003e\n\u003c!--\n  Rewrite \u003cdisk type=\"volume\"\u003e to \u003cdisk type=\"file\"\u003e.\n\n  The libvirt provider attaches pool volumes as type=\"volume\". On Ubuntu and\n  Pop!_OS, libvirt's AppArmor helper (virt-aa-helper) does not resolve pool\n  volumes to paths, so the per-VM profile omits the disks and QEMU is denied\n  access to them and their backing image. File-type disks are resolved fully.\n--\u003e\n\u003cxsl:stylesheet version=\"1.0\" xmlns:xsl=\"http://www.w3.org/1999/XSL/Transform\"\u003e\n  \u003cxsl:output method=\"xml\" indent=\"yes\"/\u003e\n\n  \u003cxsl:template match=\"@*|node()\"\u003e\n    \u003cxsl:copy\u003e\u003cxsl:apply-templates select=\"@*|node()\"/\u003e\u003c/xsl:copy\u003e\n  \u003c/xsl:template\u003e\n\n  \u003cxsl:template match=\"disk[@type='volume']\"\u003e\n    \u003cdisk type=\"file\"\u003e\n      \u003cxsl:apply-templates select=\"@*[name()!='type']|node()\"/\u003e\n    \u003c/disk\u003e\n  \u003c/xsl:template\u003e\n\n  \u003cxsl:template match=\"disk[@type='volume']/source[@pool]\"\u003e\n    \u003csource file=\"/var/lib/libvirt/images/portikus/{@volume}\"/\u003e\n  \u003c/xsl:template\u003e\n\u003c/xsl:stylesheet\u003e\n"}]},"sensitive_attributes":[],"private":"eyJlMmJmYjczMC1lY2FhLTExZTYtOGY4OC0zNDM2M2JjN2M0YzAiOnsiY3JlYXRlIjozMDAwMDAwMDAwMDB9fQ==","dependencies":["module.platform_vm.libvirt_cloudinit_disk.init","module.platform_vm.libvirt_network.portikus","module.platform_vm.libvirt_pool.portikus","module.platform_vm.libvirt_volume.base_image","module.platform_vm.libvirt_volume.data_disk","module.platform_vm.libvirt_volume.os_disk","module.platform_vm.terraform_data.base_image_verified"]}]},{"module":"module.platform_vm","mode":"managed","type":"libvirt_network","name":"portikus","provider":"provider[\"registry.opentofu.org/dmacvicar/libvirt\"]","instances":[{"schema_version":0,"attributes":{"addresses":["10.100.0.0/24"],"autostart":true,"bridge":"virbr1","dhcp":[{"enabled":true}],"dns":[],"dnsmasq_options":[],"domain":null,"id":"167925ba-a821-436d-a5b3-68bc66f9cb74","mode":"nat","mtu":null,"name":"portikus","routes":[],"xml":[]},"sensitive_attributes":[],"private":"bnVsbA=="}]},{"module":"module.platform_vm","mode":"managed","type":"libvirt_pool","name":"portikus","provider":"provider[\"registry.opentofu.org/dmacvicar/libvirt\"]","instances":[{"schema_version":0,"attributes":{"allocation":326511484928,"available":647325540352,"capacity":973837025280,"id":"d170da9a-1648-4cd8-8464-4a076a54351b","name":"portikus","path":null,"source":[],"target":[{"path":"/var/lib/libvirt/images/portikus"}],"type":"dir","xml":[]},"sensitive_attributes":[],"private