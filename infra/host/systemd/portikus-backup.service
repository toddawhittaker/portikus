# Installed by `make backup-install-timer`, which fills in the @...@ values
# (docs/adr/0024-backups-pulled-to-host.md).
[Unit]
Description=Pull a Portikus backup from the platform VM
Wants=network-online.target
After=network-online.target libvirtd.service

[Service]
Type=oneshot
# The operator's account: its SSH key reaches the VM, and it owns the sets.
User=@USER@
Environment=PORTIKUS_BACKUP_DIR=@BACKUP_DIR@
Environment=PORTIKUS_BACKUP_RECIPIENTS=@RECIPIENTS@
# The retention floor, the same as the channel unit (ADR 0039).
Environment=PORTIKUS_BACKUP_MIN_AGE_DAYS=14
Environment=PORTIKUS_BACKUP_MIN_FREE_MB=1024
Environment=PORTIKUS_BACKUP_KEEP_COMPLETE=3
# The name comes from the OpenTofu state; the VM's own hostname must match it.
ExecStart=/usr/local/sbin/portikus-backup --vm-name @VM_NAME@ @VM_IP@
Nice=10
IOSchedulingClass=idle
