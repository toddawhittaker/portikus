{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"module": "preserve",
		"moduleResolution": "bundler",
		"jsx": "react-jsx",
		"types": ["vite/client"],
		"emitDeclarationOnly": true,
		"rootDir": ".",
		"outDir": ".tsbuild"
	},
	"include": ["src/**/*.ts", "src/**/*.tsx", "vite.config.ts"],
	"references": [{ "path": "../../packages/contracts" }]
}
