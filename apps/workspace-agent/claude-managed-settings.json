{
	"env": {
		"BROWSER": "",
		"DISABLE_AUTOUPDATER": "1",
		"CLAUDE_CODE_ENABLE_TELEMETRY": "1",
		"OTEL_METRICS_EXPORTER": "otlp",
		"OTEL_LOGS_EXPORTER": "none",
		"OTEL_TRACES_EXPORTER": "none",
		"OTEL_EXPORTER_OTLP_PROTOCOL": "http/json",
		"OTEL_EXPORTER_OTLP_ENDPOINT": "http://127.0.0.1:7401",
		"OTEL_EXPORTER_OTLP_METRICS_TEMPORALITY_PREFERENCE": "delta",
		"OTEL_METRICS_INCLUDE_SESSION_ID": "false",
		"OTEL_METRICS_INCLUDE_ACCOUNT_UUID": "false"
	},
	"hooks": {
		"UserPromptSubmit": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "/opt/portikus/workspace-agent/scripts/portikus-agent-state claude working",
						"async": true
					}
				]
			},
			{
				"hooks": [
					{
						"type": "command",
						"command": "/opt/portikus/workspace-agent/scripts/portikus-agent-subagent user_prompt_submit",
						"async": true
					}
				]
			}
		],
		"PostToolUse": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "/opt/portikus/workspace-agent/scripts/portikus-agent-state claude working",
						"async": true
					}
				]
			},
			{
				"matcher": "Agent|Task",
				"hooks": [
					{
						"type": "command",
						"command": "/opt/portikus/workspace-agent/scripts/portikus-agent-subagent post_tool_use",
						"async": true
					}
				]
			}
		],
		"PreToolUse": [
			{
				"matcher": "AskUserQuestion|ExitPlanMode",
				"hooks": [
					{
						"type": "command",
						"command": "/opt/portikus/workspace-agent/scripts/portikus-agent-state claude needs-input",
						"async": true
					}
				]
			},
			{
				"matcher": "Agent|Task",
				"hooks": [
					{
						"type": "command",
						"command": "/opt/portikus/workspace-agent/scripts/portikus-agent-subagent pre_tool_use",
						"async": true
					}
				]
			},
			{
				"matcher": "AskUserQuestion",
				"hooks": [
					{
						"type": "command",
						"command": "/opt/portikus/workspace-agent/scripts/portikus-agent-question",
						"timeout": 1800
					}
				]
			}
		],
		"PermissionRequest": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "/opt/portikus/workspace-agent/scripts/portikus-agent-state claude needs-input",
						"async": true
					}
				]
			}
		],
		"Notification": [
			{
				"matcher": "elicitation_dialog|elicitation_url_dialog",
				"hooks": [
					{
						"type": "command",
						"command": "/opt/portikus/workspace-agent/scripts/portikus-agent-state claude needs-input",
						"async": true
					}
				]
			},
			{
				"matcher": "idle_prompt",
				"hooks": [
					{
						"type": "command",
						"command": "/opt/portikus/workspace-agent/scripts/portikus-agent-state claude finished",
						"async": true
					}
				]
			}
		],
		"Stop": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "/opt/portikus/workspace-agent/scripts/portikus-agent-state claude finished",
						"async": true
					}
				]
			},
			{
				"hooks": [
					{
						"type": "command",
						"command": "/opt/portikus/workspace-agent/scripts/portikus-agent-subagent stop",
						"async": true
					}
				]
			}
		],
		"StopFailure": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "/opt/portikus/workspace-agent/scripts/portikus-agent-state claude finished",
						"async": true
					}
				]
			}
		],
		"SessionEnd": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "/opt/portikus/workspace-agent/scripts/portikus-agent-state claude clear",
						"async": true
					}
				]
			}
		],
		"PostToolUseFailure": [
			{
				"matcher": "Agent|Task",
				"hooks": [
					{
						"type": "command",
						"command": "/opt/portikus/workspace-agent/scripts/portikus-agent-subagent post_tool_use_failure",
						"async": true
					}
				]
			}
		],
		"SubagentStop": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "/opt/portikus/workspace-agent/scripts/portikus-agent-subagent subagent_stop",
						"async": true
					}
				]
			}
		]
	},
	"statusLine": {
		"type": "command",
		"command": "/opt/portikus/workspace-agent/scripts/portikus-claude-status"
	}
}
