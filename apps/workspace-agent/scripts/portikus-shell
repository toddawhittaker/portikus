#!/bin/bash
# Starts the shell of an ordinary Portikus terminal (SPEC.md §9.7).

# A tmux command typed in the pane must not reach the Portikus server.
unset TMUX TMUX_PANE

start=$EPOCHREALTIME
"${SHELL:-/bin/bash}" -l
status=$?
end=$EPOCHREALTIME

# EPOCHREALTIME is seconds with six decimals; the separator follows the locale.
elapsed=$(( 10#${end//[.,]/} - 10#${start//[.,]/} ))
if (( elapsed < 1000000 )); then
	printf '%s\n' "Your shell settings (~/.bashrc or ~/.profile) made the shell exit, so this terminal started a plain shell. Fix the file, then open a new terminal."
	exec bash --noprofile --norc
fi
exit "$status"
