# Copy to .env for local development. Never commit a real .env.

# ── Shared ──────────────────────────────────────────────────────────
NODE_ENV=development

# ── API (apps/api) ──────────────────────────────────────────────────
PORT=3000
DATABASE_URL=postgres://portikus:portikus@localhost:5432/portikus
PRESENCE_TTL_SECONDS=60
WORKSPACE_HOME_SIZE_GIB=25
WORKSPACE_DOCKER_SIZE_GIB=20
PUBLIC_URL=http://127.0.0.1:5173
OIDC_ISSUER_URL=http://127.0.0.1:3002
OIDC_CLIENT_ID=portikus-dev
OIDC_CLIENT_SECRET=portikus-dev-secret
OIDC_SCOPES=openid profile email
OIDC_GROUPS_CLAIM=groups
OIDC_STUDENT_GROUP=portikus-students
OIDC_ADMIN_GROUP=portikus-administrators
SESSION_COOKIE_SECRET=dev-session-secret-not-for-production
SESSION_TTL_SECONDS=43200

# ── Mock identity provider (development and tests only) ────────
MOCK_OIDC_PORT=3002
MOCK_OIDC_ISSUER=http://127.0.0.1:3002

# ── Worker (apps/worker) ───────────────────────────────────────────
# DATABASE_URL shared with API
CONTROLLER_URL=http://127.0.0.1:3001
CONTROLLER_TOKEN=dev-controller-token-not-for-production
SHUTDOWN_GRACE_SECONDS=600
SWEEP_INTERVAL_SECONDS=1
START_TIMEOUT_SECONDS=60
STOP_TIMEOUT_SECONDS=30
STATUS_REFRESH_SECONDS=15

# ── Controller (apps/workspace-controller) ─────────────────────────
# CONTROLLER_TOKEN shared with the worker; PORT defaults to 3001
INCUS_SOCKET=/var/lib/incus/unix.socket
INCUS_PROJECT=portikus
INCUS_POOL=workspace-data
INCUS_PROFILE=workspace
INCUS_IMAGE_ALIAS=portikus

# ── Tests ──────────────────────────────────────────────────────────
# TEST_DATABASE_URL=postgres://postgres:portikus@127.0.0.1:55432/portikus_test
