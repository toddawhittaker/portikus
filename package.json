{
	"name": "portikus",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@12.4.2",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"typecheck": "tsc -b",
		"lint": "biome check --error-on-warnings . && node scripts/check-comment-history.mjs && pnpm knip && jscpd",
		"knip": "knip --no-progress",
		"lint:fix": "biome check --write .",
		"format": "biome format --write .",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"build": "tsc -b && pnpm --filter @portikus/ui build && pnpm --filter @portikus/web build",
		"test:e2e": "node e2e/with-run-database.mjs",
		"dev": "tsc -b && pnpm --filter @portikus/ui build && pnpm --parallel --filter \"./apps/*\" dev",
		"build:deb": "bash scripts/build-deb.sh"
	},
	"devDependencies": {
		"@axe-core/playwright": "4.14.0",
		"@biomejs/biome": "2.6.4",
		"@playwright/test": "1.64.1",
		"@types/node": "24.19.2",
		"@types/pg": "8.23.1",
		"@vitejs/plugin-react": "6.1.2",
		"@vitest/coverage-v8": "5.0.5",
		"jscpd": "5.4.2",
		"jsdom": "30.1.3",
		"knip": "6.43.0",
		"pg": "8.23.1",
		"tsx": "4.23.15",
		"typescript": "7.0.2",
		"vite": "8.3.5",
		"vitest": "5.0.5"
	}
}
