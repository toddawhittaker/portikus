#!/bin/sh
# portikus postinst: own the service users and the units, write the install
# answers to /etc/portikus, and start setup (docs/SPEC.md section
# 21.12).
set -e

# Units the package owns. The mock identity provider is included in the
# was-running snapshot so an upgrade restarts it, but never enabled here:
# only Ansible turns it on (ADR 0008).
UNITS="portikus-controller.service portikus-worker.service portikus-api.service"
ALL_UNITS="$UNITS portikus-mock-idp.service"

case "$1" in
	configure)
		;;
	*)
		exit 0
		;;
esac

# shellcheck source=/dev/null
. /usr/share/debconf/confmodule

# Every answer postinst reads; the secrets are the three password questions.
QUESTIONS="public_host admin_email tls acme_email tls_cert tls_key provider
entra_tenant_id google_domains oidc_issuer client_id oidc_groups_claim
ldap_host ldap_schema ldap_ip_allow ldap_bind_dn ldap_user_base_dn
ldap_user_filter ldap_group_base_dn ldap_root_ca student_group
instructor_group admin_group storage storage_confirm storage_size"
SECRETS="cloudflare_api_token client_secret ldap_bind_password"

# Each secret may live only in secrets.yaml (ruling 5), so clear them from
# debconf on every way out, a failure under set -e included.
clear_secrets() {
	for question in $SECRETS; do
		db_set "portikus/$question" "" || true
	done
}
trap clear_secrets EXIT

# Write nothing from pure defaults: with no settings file yet, the answers
# count only if someone gave them. A person answering or debconf-set-selections
# marks public_host seen; a non-interactive install with no preseed does not,
# as with `make deploy-app` onto a host the workstation Ansible manages.
configured=true
if [ ! -e /etc/portikus/portikus.yaml ]; then
	db_fget portikus/public_host seen
	[ "$RET" = true ] || configured=false
fi
missing=""
if [ "$configured" = true ]; then
for question in $QUESTIONS $SECRETS; do
	db_get "portikus/$question"
	# The values reach python3 through its environment, never its arguments.
	eval "PK_$question=\$RET"
	export "PK_$question"
done

# Writes portikus.yaml and secrets.yaml, keeping every key it does not own,
# and prints what is still missing, one item per line.
missing=$(python3 - <<'PY'
import os, yaml

CONFIG = "/etc/portikus/portikus.yaml"
SECRETS = "/etc/portikus/secrets.yaml"

def answer(name):
    return os.environ.get("PK_" + name, "").strip()

def words(name):
    return answer(name).replace(",", " ").split()

def load(path):
    try:
        with open(path) as f:
            data = yaml.safe_load(f)
    except FileNotFoundError:
        return {}
    return data if isinstance(data, dict) else {}

def write(path, data, mode, header):
    tmp = path + ".dpkg-new"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, mode)
    with os.fdopen(fd, "w") as f:
        f.write(header)
        yaml.safe_dump(data, f, default_flow_style=False, sort_keys=True)
    os.chmod(tmp, mode)
    os.replace(tmp, path)

tls = answer("tls") or "internal"
provider = answer("provider") or "dex"
storage = answer("storage")

settings = {
    "portikus_public_host": answer("public_host"),
    "portikus_admin_email": answer("admin_email"),
    "portikus_tls": tls,
    "portikus_dex_upstream": "none" if provider == "dex" else provider,
    "portikus_storage": storage,
}
if tls == "letsencrypt":
    settings["portikus_acme_email"] = answer("acme_email")
if tls == "files":
    settings["portikus_tls_cert"] = answer("tls_cert")
    settings["portikus_tls_key"] = answer("tls_key")
if provider in ("entra", "google", "oidc"):
    settings["portikus_dex_upstream_client_id"] = answer("client_id")
if provider == "entra":
    settings["portikus_entra_tenant_id"] = answer("entra_tenant_id")
if provider == "google":
    settings["portikus_google_domains"] = words("google_domains")
if provider == "oidc":
    settings["portikus_dex_upstream_issuer"] = answer("oidc_issuer")
    settings["portikus_oidc_upstream_groups_claim"] = answer("oidc_groups_claim") or "groups"
if provider == "ldap":
    for name in ("host", "schema", "bind_dn", "user_base_dn", "user_filter",
                 "group_base_dn", "root_ca"):
        settings["portikus_ldap_" + name] = answer("ldap_" + name)
    settings["portikus_ldap_ip_allow"] = words("ldap_ip_allow")
if provider == "oidc" or (provider == "ldap" and answer("ldap_group_base_dn")):
    for role in ("student", "instructor", "admin"):
        settings["portikus_oidc_%s_group" % role] = answer(role + "_group")
if storage.startswith("/dev/"):
    settings["portikus_storage_confirm"] = answer("storage_confirm") == "true"
if storage == "file" and answer("storage_size").isdigit():
    settings["portikus_storage_size"] = int(answer("storage_size"))

# Keys that follow from the answers; a key here that no longer applies is
# removed, so switching providers leaves no stale settings behind.
owned = [
    "portikus_public_host", "portikus_admin_email", "portikus_tls",
    "portikus_acme_email", "portikus_tls_cert", "portikus_tls_key",
    "portikus_dex_upstream", "portikus_dex_upstream_client_id",
    "portikus_entra_tenant_id", "portikus_google_domains",
    "portikus_dex_upstream_issuer", "portikus_oidc_upstream_groups_claim",
    "portikus_ldap_host", "portikus_ldap_schema", "portikus_ldap_bind_dn",
    "portikus_ldap_user_base_dn", "portikus_ldap_user_filter",
    "portikus_ldap_group_base_dn", "portikus_ldap_root_ca",
    "portikus_ldap_ip_allow", "portikus_oidc_student_group",
    "portikus_oidc_instructor_group", "portikus_oidc_admin_group",
    "portikus_storage", "portikus_storage_confirm", "portikus_storage_size",
]
config = load(CONFIG)
for key in owned:
    config.pop(key, None)
config.update(settings)

# A blank password keeps the stored secret.
current = load(SECRETS)
wanted = {}
if tls == "letsencrypt":
    wanted["portikus_cloudflare_api_token"] = answer("cloudflare_api_token")
if provider in ("entra", "google", "oidc"):
    wanted["portikus_dex_upstream_client_secret"] = answer("client_secret")
if provider == "ldap":
    wanted["portikus_ldap_bind_password"] = answer("ldap_bind_password")
secrets = {k: v for k, v in current.items() if k not in (
    "portikus_cloudflare_api_token", "portikus_dex_upstream_client_secret",
    "portikus_ldap_bind_password")}
for key, value in wanted.items():
    if value:
        secrets[key] = value
    elif current.get(key):
        secrets[key] = current[key]

os.makedirs("/etc/portikus", mode=0o755, exist_ok=True)
write(CONFIG, config, 0o644,
      "# Portikus settings: Ansible variables for `portikus setup`.\n"
      "# Written by `dpkg-reconfigure portikus`, which keeps keys it does not own.\n")
write(SECRETS, secrets, 0o600,
      "# Portikus secrets, readable by root only. Written by `dpkg-reconfigure portikus`.\n")

needed = {
    "portikus_public_host": "the web address (public_host)",
    "portikus_admin_email": "the administrator's email (admin_email)",
}
if tls == "letsencrypt":
    needed["portikus_acme_email"] = "the email for Let's Encrypt (acme_email)"
if tls == "files":
    needed["portikus_tls_cert"] = "the certificate file (tls_cert)"
    needed["portikus_tls_key"] = "the private key file (tls_key)"
if provider in ("entra", "google", "oidc"):
    needed["portikus_dex_upstream_client_id"] = "the client ID (client_id)"
if provider == "entra":
    needed["portikus_entra_tenant_id"] = "the Entra tenant ID (entra_tenant_id)"
if provider == "google":
    needed["portikus_google_domains"] = "the Google Workspace domains (google_domains)"
if provider == "oidc":
    needed["portikus_dex_upstream_issuer"] = "the provider's issuer URL (oidc_issuer)"
if provider == "ldap":
    needed["portikus_ldap_host"] = "the directory server (ldap_host)"
    needed["portikus_ldap_ip_allow"] = "the directory server addresses (ldap_ip_allow)"
    needed["portikus_ldap_bind_dn"] = "the service account (ldap_bind_dn)"
    needed["portikus_ldap_user_base_dn"] = "where people are (ldap_user_base_dn)"
    needed["portikus_ldap_user_filter"] = "who may sign in (ldap_user_filter)"
if storage == "file":
    needed["portikus_storage_size"] = "the size of the storage file (storage_size)"
for key, text in needed.items():
    if not config.get(key):
        print("- " + text)
if not storage:
    print("- where to keep student files (storage)")
elif storage.startswith("/dev/") and config.get("portikus_storage_confirm") is not True:
    print("- confirmation that everything on %s may be erased (storage_confirm)" % storage)
names = {
    "portikus_cloudflare_api_token": "the Cloudflare API token (cloudflare_api_token)",
    "portikus_dex_upstream_client_secret": "the client secret (client_secret)",
    "portikus_ldap_bind_password": "the service account password (ldap_bind_password)",
}
for key in wanted:
    if not secrets.get(key):
        print("- " + names[key])
PY
)

db_get portikus/public_host
public_host=$RET
db_get portikus/admin_email
admin_email=$RET
# A port set by hand in portikus.yaml belongs in the address too.
public_port=$(python3 -c 'import yaml; d = yaml.safe_load(open("/etc/portikus/portikus.yaml")); print(d.get("portikus_public_port", 443) if isinstance(d, dict) else 443)' 2>/dev/null || echo 443)
site_url="https://$public_host"
[ "$public_port" = 443 ] || site_url="$site_url:$public_port"
fi
clear_secrets
trap - EXIT
db_stop

for user in portikus portikus-controller; do
	if ! getent passwd "$user" >/dev/null; then
		adduser --system --group --no-create-home --home /nonexistent \
			--shell /usr/sbin/nologin "$user"
	fi
done

# The controller needs the Incus socket; the group exists only once Incus does.
if getent group incus-admin >/dev/null; then
	adduser portikus-controller incus-admin
fi

# Nothing to drive when systemd is not running, as in a container or chroot.
if [ -d /run/systemd/system ]; then
	# Note which units were running before the reload, so an upgrade restarts them.
	running=""
	for unit in $ALL_UNITS; do
		if systemctl is-active --quiet "$unit"; then
			running="$running $unit"
		fi
	done

	systemctl daemon-reload

	# $2 holds the previously configured version, so it is empty on first install.
	if [ -z "$2" ]; then
		for unit in $UNITS; do
			systemctl enable "$unit" >/dev/null
		done
	fi

	# The mock provider first so the API can reach its issuer, then the api,
	# which runs the database migrations in ExecStartPre.
	for unit in portikus-mock-idp.service portikus-api.service portikus-controller.service portikus-worker.service; do
		case " $running " in
			*" $unit "*) systemctl restart "$unit" || true ;;
		esac
	done
fi

# A running oneshot unit is "activating", which is-active reports as inactive.
setup_running() {
	case "$(systemctl show -P ActiveState portikus-setup.service)" in
	active | activating | reloading) return 0 ;;
	*) return 1 ;;
	esac
}

# debconf owns stdout while it runs, so everything below goes to stderr.
if [ "$configured" = false ]; then
	echo "Portikus is not configured yet: run dpkg-reconfigure portikus" >&2
elif [ -n "$missing" ]; then
	cat >&2 <<EOF

Portikus is installed, but setup has not started. It still needs:
$missing

Answer the questions with:  sudo dpkg-reconfigure portikus

EOF
elif [ -d /run/systemd/system ] && setup_running; then
	# Starting an active unit does nothing, so this change is not applied yet.
	cat >&2 <<EOF

Setup is already running with the earlier answers; when it ends, run: sudo portikus setup

EOF
elif [ -d /run/systemd/system ]; then
	# Setup waits for the dpkg lock, so it must not block this script (ruling 10).
	systemctl start --no-block portikus-setup.service
	if [ -z "$2" ]; then
		cat >&2 <<EOF

Portikus setup is running in the background. It takes about ten minutes.

  1. Follow it with:  sudo portikus setup --follow
  2. When it finishes, read the administrator's one-time password with:
       sudo cat /etc/portikus/admin-password
  3. Sign in at $site_url
     as $admin_email and choose a new password.

EOF
	else
		# An upgrade or a reconfigure: the administrator already exists.
		cat >&2 <<EOF

Portikus setup is running in the background to apply this change.
Follow it with:  sudo portikus setup --follow

EOF
	fi
else
	cat >&2 <<EOF

Portikus is installed. systemd is not running here, so run setup with:
  sudo portikus setup

EOF
fi

exit 0
