#!/bin/sh
# portikus prerm: stop the services before the files go away.
set -e

if [ "$1" = "remove" ] && [ -d /run/systemd/system ]; then
	systemctl stop portikus-api.service portikus-worker.service \
		portikus-controller.service \
		portikus-backup.timer portikus-backup-channel.timer portikus-backup-key.socket \
		portikus-image-job.path portikus-egress-apply.path portikus-setup.service \
		portikus-image-job.service portikus-egress-apply.service \
		portikus-backup.service portikus-backup-channel.service \
		portikus-backup-offsite.timer portikus-backup-offsite.service \
		portikus-image-check.timer portikus-image-check.service \
		portikus-registry-job.path portikus-registry-status.timer \
		portikus-registry-job.service portikus-registry-status.service \
		portikus-registry-hub.service portikus-registry-ghcr.service \
		portikus-root-shell.socket 'portikus-root-shell@*.service' \
		portikus-alerts-job.path portikus-alerts-job.service || true
	# Setup enables these; left enabled, their links dangle once the unit files are gone.
	systemctl disable portikus-image-job.path portikus-egress-apply.path \
		portikus-image-check.timer portikus-backup.timer portikus-backup-channel.timer \
		portikus-backup-key.socket portikus-backup-offsite.timer portikus-setup.service \
		portikus-registry-job.path portikus-registry-status.timer \
		portikus-registry-hub.service portikus-registry-ghcr.service \
		portikus-root-shell.socket portikus-alerts-job.path >/dev/null 2>&1 || true
fi

exit 0
