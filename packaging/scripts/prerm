#!/bin/sh
# portikus prerm: stop the services before the files go away.
set -e

if [ "$1" = "remove" ] && [ -d /run/systemd/system ]; then
	systemctl stop portikus-api.service portikus-worker.service \
		portikus-controller.service portikus-mock-idp.service \
		portikus-backup.timer portikus-backup-channel.timer portikus-backup-key.socket \
		portikus-image-job.path portikus-egress-apply.path portikus-setup.service || true
	systemctl disable portikus-image-job.path portikus-egress-apply.path \
		portikus-setup.service >/dev/null 2>&1 || true
fi

exit 0
