#!/usr/bin/python3 -I
"""The root side of the admin page's root shell (docs/adr/0051-root-shell.md).

portikus-root-shell.socket starts one of these per connection, as root, with
the connection on standard input and output.  Only the API (user portikus)
may connect.  The helper runs `login -f root -h <address>` on a pseudo-terminal,
so each shell is a real PAM sign-in session with its own logind scope, and
relays the terminal over a framed protocol.

Each frame is a 1-byte type, a 4-byte big-endian body length, then the body:

  from the API     0x01 open    JSON {shellId, actorId, actorName, address, cols, rows}
                   0x02 input   bytes typed into the shell
                   0x03 resize  JSON {cols, rows}
                   0x04 end     JSON {reason}: the session was revoked, so the
                                whole logind session ends, not only the shell
  to the API       0x81 output  bytes the shell printed
                   0x82 exit    JSON {status}
                   0x83 error   JSON {code}

Closing the connection without `end` only hangs up the shell, so a tmux the
administrator started survives.  Nothing the shell reads or prints, and no
actorName, ever reaches standard error, which is the journal (ADR 0012).

Each shell has a record under /run/portikus-root-shell: login's PID and,
once login has joined it, its logind session.  The record stays while that
session lives, so `root-shell --end-sessions`, the off switch's half, can
end what a closed pane left running there, such as tmux, and what moved out
of the session but kept its audit id.
"""

import errno
import fcntl
import ipaddress
import json
import os
import pwd
import re
import selectors
import signal
import socket
import struct
import subprocess
import sys
import termios
import time
import uuid

OPEN, INPUT, RESIZE, END = 0x01, 0x02, 0x03, 0x04
OUTPUT, EXIT, ERROR = 0x81, 0x82, 0x83

# Checked against the header's length before any of the body is read.
CAPS = {OPEN: 4096, INPUT: 65536, RESIZE: 64, END: 64}
HEADER = struct.Struct(">BI")
OPEN_FIELDS = {"shellId", "actorId", "actorName", "address", "cols", "rows"}
MAX_SIZE = 1000
MAX_NAME = 256
MAX_REASON = 32
READ_CHUNK = 65536
# Typed input waiting for a shell that is not reading; input past this is dropped.
# The socket is always read, so `end` and a close are seen however full this is.
MAX_PENDING = 4 * CAPS[INPUT]
DROPPED_NOTICE = (b"\r\n[Portikus: typed input was dropped because the shell was busy"
                  b" and more than %d KiB was waiting]\r\n" % (MAX_PENDING // 1024))

PEER_USER = "portikus"
LOGIN = "/bin/login"
RUN_DIR = "/run/portikus-root-shell"
BANNER = (b"\x1b[1mPortikus root shell on this server.\x1b[0m Nothing typed or shown here is recorded;"
          b" opening and closing it are audited.\r\n"
          b"Run upgrades and long jobs inside tmux: closing this pane or restarting Portikus ends the shell.\r\n")
# How long a hung-up shell has to end its PAM session before login is told to.
HANGUP_GRACE = 5.0
# How often to look again while no process holds the terminal open.
NO_TERMINAL_POLL = 0.05
SESSION_ID = r"[A-Za-z0-9_-]{1,64}"
SESSION_SCOPE = re.compile(r"/session-(%s)\.scope$" % SESSION_ID)
# login uses this PAM service when given -h; only these sessions are ours to end.
PAM_SERVICE = "remote"
# The audit id of a process outside any sign-in, such as a service.
NO_AUDIT_SESSION = str(2 ** 32 - 1)


class Stopped(Exception):
    """systemctl stop sent SIGTERM."""


class ProtocolError(Exception):
    """A frame broke the protocol; `code` is a fixed string safe to log and send."""

    def __init__(self, code):
        super().__init__(code)
        self.code = code


def log(message):
    # Only fixed text and validated values reach here, never shell bytes.
    sys.stderr.write("portikus-root-shell: %s\n" % message)
    sys.stderr.flush()


def encode(kind, body):
    return HEADER.pack(kind, len(body)) + body


def encode_json(kind, value):
    return encode(kind, json.dumps(value, separators=(",", ":")).encode())


class FrameReader:
    """Splits the byte stream into frames, refusing a body over its type's cap before buffering it."""

    def __init__(self):
        self.buffer = b""

    def feed(self, data):
        self.buffer += data
        frames = []
        while len(self.buffer) >= HEADER.size:
            kind, length = HEADER.unpack_from(self.buffer)
            cap = CAPS.get(kind)
            if cap is None:
                raise ProtocolError("unknown-type")
            if length > cap:
                raise ProtocolError("too-large")
            if len(self.buffer) < HEADER.size + length:
                break
            frames.append((kind, self.buffer[HEADER.size:HEADER.size + length]))
            self.buffer = self.buffer[HEADER.size + length:]
        return frames


def parse_json(body, code):
    try:
        value = json.loads(body.decode("utf-8"))
    except (UnicodeDecodeError, ValueError):
        raise ProtocolError(code) from None
    if not isinstance(value, dict):
        raise ProtocolError(code)
    return value


def size(value):
    # bool is an int in Python; a JSON true is not a size.
    return isinstance(value, int) and not isinstance(value, bool) and 1 <= value <= MAX_SIZE


def canonical_uuid(value):
    if not isinstance(value, str):
        return None
    try:
        parsed = uuid.UUID(value)
    except ValueError:
        return None
    # Only the plain 36-character form, so the journal line is the API's own id.
    return str(parsed) if str(parsed) == value.lower() else None


def parse_open(body):
    """The validated open frame: shell id, actor id, address and size.  actorName is checked, then dropped."""
    value = parse_json(body, "invalid-open")
    if set(value) != OPEN_FIELDS:
        raise ProtocolError("invalid-open")
    shell_id = canonical_uuid(value["shellId"])
    actor_id = canonical_uuid(value["actorId"])
    name = value["actorName"]
    if shell_id is None or actor_id is None or not isinstance(name, str) or len(name) > MAX_NAME:
        raise ProtocolError("invalid-open")
    if not isinstance(value["address"], str):
        raise ProtocolError("invalid-open")
    try:
        address = str(ipaddress.ip_address(value["address"]))
    except ValueError:
        raise ProtocolError("invalid-open") from None
    if not size(value["cols"]) or not size(value["rows"]):
        raise ProtocolError("invalid-open")
    return {"shellId": shell_id, "actorId": actor_id, "address": address,
            "cols": value["cols"], "rows": value["rows"]}


def parse_resize(body):
    value = parse_json(body, "invalid-resize")
    if set(value) != {"cols", "rows"} or not size(value["cols"]) or not size(value["rows"]):
        raise ProtocolError("invalid-resize")
    return value["cols"], value["rows"]


def parse_end(body):
    value = parse_json(body, "invalid-end")
    reason = value.get("reason")
    if set(value) != {"reason"} or not isinstance(reason, str) or not re.fullmatch(r"[a-z_]{1,%d}" % MAX_REASON, reason):
        raise ProtocolError("invalid-end")
    return reason


class Protocol:
    """The order rules: open first and once, then input, resize and end."""

    def __init__(self):
        self.opened = None

    def accept(self, kind, body):
        if self.opened is None:
            if kind != OPEN:
                raise ProtocolError("not-open")
            self.opened = parse_open(body)
            return ("open", self.opened)
        if kind == OPEN:
            raise ProtocolError("already-open")
        if kind == INPUT:
            return ("input", body)
        if kind == RESIZE:
            return ("resize", parse_resize(body))
        return ("end", parse_end(body))


def peer_allowed(peer_uid, allowed_uid):
    return allowed_uid is not None and peer_uid == allowed_uid


def peer_uid(sock):
    creds = sock.getsockopt(socket.SOL_SOCKET, socket.SO_PEERCRED, struct.calcsize("3i"))
    return struct.unpack("3i", creds)[1]


def allowed_uid():
    try:
        return pwd.getpwnam(PEER_USER).pw_uid
    except KeyError:
        return None


def set_size(fd, cols, rows):
    fcntl.ioctl(fd, termios.TIOCSWINSZ, struct.pack("HHHH", rows, cols, 0, 0))


def login_argv(address):
    # Never -p: the environment is login's own, plus the TERM it keeps.
    return [LOGIN, "-f", "root", "-h", address]


def spawn(argv, cols, rows):
    """Starts argv on a new pseudo-terminal whose terminal end is fds 0 to 2, with no other descriptor."""
    master, slave = os.openpty()
    set_size(slave, cols, rows)
    env = {"PATH": "/usr/sbin:/usr/bin:/sbin:/bin", "TERM": os.environ.get("TERM") or "xterm-256color"}
    pid = os.fork()
    if pid == 0:
        try:
            os.close(master)
            os.login_tty(slave)
            os.closerange(3, os.sysconf("SC_OPEN_MAX"))
            for sig in (signal.SIGTERM, signal.SIGHUP, signal.SIGPIPE, signal.SIGCHLD):
                signal.signal(sig, signal.SIG_DFL)
            os.execve(argv[0], argv, env)
        finally:
            os._exit(127)
    os.close(slave)
    return master, pid


def session_of(pid, proc="/proc"):
    """The logind session whose scope holds pid, or None."""
    try:
        with open("%s/%d/cgroup" % (proc, pid)) as f:
            for line in f:
                match = SESSION_SCOPE.search(line.rstrip("\n"))
                if match:
                    return match.group(1)
    except OSError:
        pass
    return None


def is_login(pid, proc="/proc"):
    # A recorded PID the kernel has since given to another process is not ours.
    try:
        with open("%s/%d/comm" % (proc, pid)) as f:
            return f.read().strip() == "login"
    except OSError:
        return False


def terminate_session(session, run=subprocess.run):
    """Ends the session and every process left in its scope."""
    quiet = {"stdin": subprocess.DEVNULL, "stdout": subprocess.DEVNULL, "stderr": subprocess.DEVNULL}
    ended = run(["loginctl", "terminate-session", session], **quiet).returncode == 0
    # Once login has exited, logind abandons the scope and terminate-session no longer
    # stops it, so a tmux server left there would live on.
    run(["loginctl", "kill-session", session, "--signal=SIGKILL"], **quiet)
    return ended


def audit_session(pid, proc="/proc"):
    try:
        with open("%s/%d/sessionid" % (proc, pid)) as f:
            return f.read().strip()
    except OSError:
        return None


def session_pids(session, proc="/proc"):
    """Processes that carry the session's audit id, wherever their cgroup now is.

    logind names a session after its audit id, which every process started in
    it inherits and keeps, also one moved out of the scope, as `systemd-run
    --scope` does.  A name that is not a number has no audit id to match.
    """
    if not session.isdigit() or session == NO_AUDIT_SESSION:
        return []
    try:
        names = os.listdir(proc)
    except OSError:
        return []
    return [int(name) for name in names
            if name.isdigit() and int(name) != os.getpid() and audit_session(int(name), proc) == session]


def kill_in_session(pid, session, proc="/proc"):
    """SIGKILL pid if it still carries the session; through a pidfd, so a reused PID is never hit."""
    try:
        fd = os.pidfd_open(pid)
    except OSError:
        return False
    try:
        if audit_session(pid, proc) != session:
            return False
        signal.pidfd_send_signal(fd, signal.SIGKILL)
        return True
    except OSError:
        return False
    finally:
        os.close(fd)


def kill_strays(session, proc="/proc", kill=kill_in_session):
    """Kills what a root shell's session left outside its scope; returns how many."""
    return sum(1 for pid in session_pids(session, proc) if kill(pid, session, proc))


def transient_units(run=subprocess.run):
    """Running units under systemd-run's own names.  A root shell may have
    started one, and the unit carries nothing that says so, so the off switch
    only names them."""
    done = run(["systemctl", "list-units", "--plain", "--no-legend", "--state=active", "run-*"],
               stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True)
    return [line.split()[0] for line in done.stdout.splitlines() if line.strip()] if done.returncode == 0 else []


def session_service(session, run=subprocess.run):
    """The PAM service of a logind session that still exists, or None."""
    done = run(["loginctl", "show-session", session, "-P", "Service"],
               stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True)
    return done.stdout.strip() if done.returncode == 0 else None


def record_path(run_dir, shell_id):
    return os.path.join(run_dir, shell_id)


def create_record(run_dir, shell_id):
    """Claims the shell id before login starts; false if another shell holds it."""
    os.makedirs(run_dir, mode=0o700, exist_ok=True)
    os.chmod(run_dir, 0o700)
    try:
        os.close(os.open(record_path(run_dir, shell_id), os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600))
    except FileExistsError:
        return False
    return True


def write_record(run_dir, shell_id, pid, session=None):
    path = record_path(run_dir, shell_id)
    # A record the off switch removed stays removed.
    if not os.path.exists(path):
        raise FileNotFoundError(path)
    # Renamed into place, so a reader never sees it half written.  The dot
    # keeps the temporary name out of records().
    temporary = os.path.join(run_dir, "." + shell_id)
    fd = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW, 0o600)
    with os.fdopen(fd, "w") as f:
        f.write("%d %s\n" % (pid, session) if session else "%d\n" % pid)
    os.replace(temporary, path)


def read_record(run_dir, shell_id):
    """(login pid, session), either None when missing or malformed."""
    try:
        with open(record_path(run_dir, shell_id)) as f:
            fields = f.read(128).split()
    except OSError:
        return None, None
    pid = int(fields[0]) if fields and fields[0].isdigit() else None
    session = fields[1] if len(fields) == 2 and re.fullmatch(SESSION_ID, fields[1]) else None
    return pid, session


def forget_record(run_dir, shell_id):
    try:
        os.unlink(record_path(run_dir, shell_id))
    except FileNotFoundError:
        pass


def records(run_dir):
    try:
        return [name for name in sorted(os.listdir(run_dir)) if canonical_uuid(name) is not None]
    except FileNotFoundError:
        return []


def end_sessions(run_dir=RUN_DIR, proc="/proc", run=subprocess.run, kill=kill_in_session):
    """Ends every recorded root-shell session and what left it; returns how many shells had anything to end.

    A session that still exists must be a `remote` sign-in.  One logind has
    forgotten counts only when the helper itself recorded it, since audit ids
    are never reused before a reboot clears /run.
    """
    ended = 0
    for name in records(run_dir):
        pid, session = read_record(run_dir, name)
        # Empty or unreadable: its helper has not yet started login, and records it next.
        if pid is None and session is None:
            continue
        recorded = session is not None
        # Login had not joined its session when the record was written; a reused PID is not ours.
        if session is None and pid is not None and is_login(pid, proc):
            session = session_of(pid, proc)
        if session is not None:
            service = session_service(session, run)
            ours = service == PAM_SERVICE or (recorded and service is None)
            terminated = service == PAM_SERVICE and terminate_session(session, run)
            strays = kill_strays(session, proc, kill) if ours else 0
            if terminated or strays:
                log("ended session %s of shell %s, and killed %d processes that had left it" % (session, name, strays))
                ended += 1
        forget_record(run_dir, name)
    return ended


def session_over(session, run=subprocess.run, proc="/proc"):
    """Whether logind has forgotten the session and no process left it carrying its id."""
    return session_service(session, run) is None and not session_pids(session, proc)


def prune_records(run_dir=RUN_DIR, run=subprocess.run, proc="/proc"):
    """Forgets the records of sessions that are over; a record not yet naming one may be a shell starting."""
    for name in records(run_dir):
        _, session = read_record(run_dir, name)
        if session is not None and session_over(session, run, proc):
            forget_record(run_dir, name)


class Shell:
    """One connection: the socket, the login child on its pseudo-terminal, and the relay between them."""

    def __init__(self, sock, run_dir=RUN_DIR, argv_for=login_argv, banner=BANNER,
                 session_for=session_of, run=subprocess.run, kill=kill_in_session, proc="/proc"):
        self.sock = sock
        self.session_for = session_for
        # Every loginctl call goes through this, so tests can never reach a real session.
        self.run_command = run
        self.kill = kill
        self.proc = proc
        self.recorded = False
        self.session = None
        self.run_dir = run_dir
        self.argv_for = argv_for
        self.banner = banner
        self.protocol = Protocol()
        self.reader = FrameReader()
        self.master = None
        self.pid = None
        self.status = None
        self.started = None
        self.pending = bytearray()
        self.dropping = False

    def send(self, data):
        try:
            self.sock.sendall(data)
            return True
        except OSError:
            return False

    def flush(self):
        """Types what it can of the pending input; false once the terminal is gone."""
        while self.pending:
            try:
                written = os.write(self.master, self.pending)
            except BlockingIOError:
                return True
            except OSError as e:
                # EIO: nothing holds the terminal open for now; only login's exit ends the shell.
                return e.errno == errno.EIO
            del self.pending[:written]
        return True

    def queue(self, data):
        """Queues typed input whole or not at all, so a pasted script never runs with lines missing."""
        # Dropped past the cap rather than left unread, so `end` behind it is still seen.
        if self.dropping and not self.pending:
            self.dropping = False
        if self.dropping:
            return
        if len(self.pending) + len(data) > MAX_PENDING:
            # Every later frame goes too, until the shell has taken all that was waiting.
            self.dropping = True
            self.send(encode(OUTPUT, DROPPED_NOTICE))
            return
        self.pending += data

    def watch(self, selector):
        # Never block on the terminal: a shell blocked printing would never read what we type.
        if self.sock not in selector.get_map():
            selector.register(self.sock, selectors.EVENT_READ, "socket")
        if self.master is not None:
            events = selectors.EVENT_READ | (selectors.EVENT_WRITE if self.pending else 0)
            if self.master in selector.get_map():
                selector.modify(self.master, events, "terminal")
            else:
                selector.register(self.master, events, "terminal")

    def refuse(self, code):
        self.send(encode_json(ERROR, {"code": code}))
        log("refused a connection: %s" % code)

    def start(self, opened):
        if not create_record(self.run_dir, opened["shellId"]):
            raise ProtocolError("duplicate-shell")
        self.recorded = True
        self.master, self.pid = spawn(self.argv_for(opened["address"]), opened["cols"], opened["rows"])
        os.set_blocking(self.master, False)
        self.started = time.monotonic()
        write_record(self.run_dir, opened["shellId"], self.pid)
        log("opened shell %s for actor %s from %s, login pid %d"
            % (opened["shellId"], opened["actorId"], opened["address"], self.pid))
        self.send(encode(OUTPUT, self.banner))

    def reap(self, block=False):
        if self.pid is None or self.status is not None:
            return self.status is not None
        try:
            pid, status = os.waitpid(self.pid, 0 if block else os.WNOHANG)
        except ChildProcessError:
            self.status = 0
            return True
        if pid == 0:
            return False
        self.status = os.waitstatus_to_exitcode(status)
        return True

    def hang_up(self):
        """Closes the terminal, which sends the shell SIGHUP; login then closes its PAM session."""
        if self.master is not None:
            os.close(self.master)
            self.master = None
        deadline = time.monotonic() + HANGUP_GRACE
        while not self.reap() and time.monotonic() < deadline:
            time.sleep(0.05)
        if self.status is None:
            # login forwards SIGTERM and SIGHUP to the shell, then closes its session.
            os.kill(self.pid, signal.SIGTERM)
            deadline = time.monotonic() + HANGUP_GRACE
            while not self.reap() and time.monotonic() < deadline:
                time.sleep(0.05)
        if self.status is None:
            os.kill(self.pid, signal.SIGKILL)
            self.reap(block=True)

    def drain(self):
        """Sends what the shell printed before it ended."""
        while True:
            try:
                data = os.read(self.master, READ_CHUNK)
            except OSError:
                return
            if not data or not self.send(encode(OUTPUT, data)):
                return

    def learn_session(self):
        """Records login's session once pam_systemd has moved login into it."""
        if self.session is not None or self.pid is None or self.status is not None:
            return
        session = self.session_for(self.pid)
        if session is not None:
            self.session = session
            write_record(self.run_dir, self.protocol.opened["shellId"], self.pid, session)

    def end_session(self):
        self.pending.clear()
        session = self.session or self.session_for(self.pid)
        if session is None:
            return False
        ended = terminate_session(session, self.run_command)
        kill_strays(session, self.proc, self.kill)
        return ended

    def finish(self):
        if not self.reap():
            self.hang_up()
        self.send(encode_json(EXIT, {"status": self.status}))
        return "exit"

    def run(self):
        """Serves the connection to its end; returns the reason it ended, a fixed string."""
        selector = selectors.DefaultSelector()
        try:
            while True:
                # A background job can hold the terminal open after the shell ends, so watch login too.
                if self.reap():
                    self.drain()
                    return self.finish()
                self.learn_session()
                self.watch(selector)
                for key, events in selector.select(timeout=0.5):
                    if key.data == "socket":
                        try:
                            data = self.sock.recv(READ_CHUNK)
                        except OSError:
                            data = b""
                        if not data:
                            return "client"
                        for kind, body in self.reader.feed(data):
                            action, value = self.protocol.accept(kind, body)
                            if action == "open":
                                self.start(value)
                            elif action == "input":
                                self.queue(value)
                                if not self.flush():
                                    return self.finish()
                            elif action == "resize":
                                set_size(self.master, *value)
                            else:
                                return "end:" + value
                        continue
                    if events & selectors.EVENT_WRITE and not self.flush():
                        return self.finish()
                    if not events & selectors.EVENT_READ:
                        continue
                    try:
                        data = os.read(self.master, READ_CHUNK)
                    except BlockingIOError:
                        continue
                    except OSError as e:
                        if e.errno != errno.EIO:
                            raise
                        # No process holds the terminal open, as during login's vhangup()
                        # or after the shell exits; the reap at the top of the loop decides.
                        time.sleep(NO_TERMINAL_POLL)
                        continue
                    if not data:
                        return self.finish()
                    if not self.send(encode(OUTPUT, data)):
                        return "client"
        except ProtocolError as e:
            self.refuse(e.code)
            return "protocol"
        finally:
            selector.close()

    def close(self, reason):
        if self.pid is None:
            # login never started, so the claimed id leads nowhere.
            if self.recorded:
                forget_record(self.run_dir, self.protocol.opened["shellId"])
            return
        opened = self.protocol.opened
        ended = False
        if reason.startswith("end:"):
            ended = self.end_session()
            reason = "%s, session %s" % (reason[4:], "ended" if ended else "not found")
        if self.status is None:
            self.hang_up()
        # Kept while the session lives on, as with the administrator's tmux, for the off switch.
        if ended or self.session is None or session_over(self.session, self.run_command):
            forget_record(self.run_dir, opened["shellId"])
        prune_records(self.run_dir, self.run_command)
        log("closed shell %s for actor %s from %s, login pid %d, session %s, after %d seconds (%s)"
            % (opened["shellId"], opened["actorId"], opened["address"], self.pid, self.session or "none",
               int(time.monotonic() - self.started), reason))


def serve(sock, uid, run_dir=RUN_DIR, argv_for=login_argv, banner=BANNER, **session_calls):
    shell = Shell(sock, run_dir, argv_for, banner, **session_calls)
    if not peer_allowed(peer_uid(sock), uid):
        shell.refuse("peer-refused")
        return
    reason = "client"
    try:
        reason = shell.run()
    except Stopped:
        reason = "stopped"
    finally:
        # A second stop must not cut the hang-up and the closing line short.
        signal.signal(signal.SIGTERM, signal.SIG_IGN)
        shell.close(reason)


def stop(*_):
    raise Stopped()


def main(args):
    if args == ["--end-sessions"]:
        print("ended %d" % end_sessions())
        for unit in transient_units():
            print("transient %s" % unit)
        return 0
    if args:
        log("unknown arguments")
        return 2
    # systemctl stop: leave through close(), so the shell is hung up and recorded.
    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGPIPE, signal.SIG_IGN)
    sock = socket.socket(fileno=os.dup(0))
    null = os.open(os.devnull, os.O_RDWR)
    os.dup2(null, 0)
    os.dup2(null, 1)
    os.close(null)
    try:
        serve(sock, allowed_uid())
    except Exception as e:  # noqa: BLE001 -- exception text could carry shell bytes, so only the class name
        log("internal error: %s" % type(e).__name__)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
