				"https://LMS.Example.edu/x"
			],
			"bad": [
				"",
				"http://lms.example.edu",
				"ftp://lms.example.edu",
				"lms.example.edu",
				"https://user:pw@lms.example.edu/",
				"https://user@lms.example.edu/",
				"https://10.0.0.1/x",
				"https://lms.example.edu/{{ 7*7 }}",
				"https://lms.example.edu/\u0007",
				"https://"
			]
		},
		"keysetUrl": {
			"where": "lti-platforms platforms[].keysetUrl, platforms[].authTokenUrl",
			"good": [
				"https://lms.example.edu/jwks",
