{
	"_about": "Values the root site job and the API's schemas (packages/contracts/src/site.ts) must agree on, field by field: every good value is accepted and every bad value refused (ADR 0059). packaging/site/tests checks the job; the API's route tests check the schemas. An entry's 'where' names the request fields that use it.",
	"fields": {
		"proxyHost": {
			"where": "proxy-hosts hosts[]",
			"good": [
				"api.example.com",
				"API.Example.com",
				"localhost",
				"a-b.example.co.uk",
				"x1.example.org"
			],
			"bad": [
				"",
				"1.2.3.4",
				"api.example.com:443",
				"https://api.example.com",
				"*.example.com",
				".example.com",
				"example.com.",
				"a..b",
				"-a.example.com",
				"exa mple.com",
				"example.com\n",
				"{{ 7*7 }}",
				"{api}.example.com",
				"x.123",
				"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.example.com",
				"例え.jp"
			]
		},
		"siteHost": {
			"where": "address host, signin googleDomains[]",
			"good": [
				"portikus.example.edu",
				"a.b",
				"pilot.portikus.thewhittakers.org",
				"portikus.192.168.10.48.nip.io"
			],
			"bad": [
				"",
				"Portikus.example.edu",
				"localhost",
				"1.2.3.4",
				"portikus.example.edu:443",
				"https://portikus.example.edu",
				"portikus.example.edu.",
				"x.123",
				"{{ 7*7 }}",
				"portikus .example.edu",
				"portikus.example.edu\u0000"
			]
		},
		"sitePort": {
			"where": "address port",
			"good": [443, 1024, 8443, 65535],
			"bad": [
				80,
				0,
				-1,
				1023,
				65536,
				3000,
				3128,
				5432,
				5556,
				7400,
				8792,
				8443.5,
				"8443",
				true,
				null
			]
		},
