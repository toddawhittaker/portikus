#!/bin/sh
# The Portikus host command, for root on the VM (SPEC.md section 5.1).
set -eu

API_ENV=/etc/portikus/api.env
WORKER_ENV=/etc/portikus/worker.env
BACKUP_CHANNEL_MAIN=/usr/lib/portikus/worker/dist/backup-channel-main.js
PASSWORD_FILE=/etc/portikus/admin-password
RESET_ADMIN_MAIN=/usr/lib/portikus/api/node_modules/@portikus/auth/dist/reset-admin-main.js
NODE=/usr/lib/portikus/node/bin/node
ANSIBLE_DIR=/usr/share/portikus/ansible
CONFIG_FILE=/etc/portikus/portikus.yaml
SECRETS_FILE=/etc/portikus/secrets.yaml
SETUP_UNIT=portikus-setup.service
UNITS="portikus-setup portikus-api portikus-worker portikus-controller portikus-egress-apply.path"
READ_LINE="Read the local administrator's one-time password with: sudo cat ${PASSWORD_FILE}"

usage() {
  cat <<EOF
Usage: portikus setup [--follow]
       portikus status
       portikus reset-admin [--email ADDRESS] [--if-missing]
       portikus backup-channel pull|report

setup        Apply ${CONFIG_FILE} to this host with the shipped Ansible
             play, in the foreground.  Safe to run again.
             --follow  follow the journal of ${SETUP_UNIT} instead
status       Show the package version and the state of each unit.

reset-admin  Give the local administrator a new one-time password, the
             administrator role, and a working account, and end its
             sessions.  Creates it if it is missing.  The password goes
             only to ${PASSWORD_FILE}.
             --email ADDRESS  the email for an administrator created now
             --if-missing     do nothing if the account exists; exit 10
                              while its one-time password is unchanged,
                              11 once it has chosen its own

backup-channel pull    Claim the oldest waiting backup request for the
                       host and print it as one JSON line; print nothing
                       when none waits.
backup-channel report  Read the host's report, one JSON document, on
                       standard input and store it.  Exits 2 when the
                       document is refused.
EOF
}

# Runs the play against this host (docs/EPIC-15.md, ruling 8, ADR 0029).
setup() {
  case "${1:-}" in
    --follow)
      exec journalctl --unit="${SETUP_UNIT}" --follow --no-pager
      ;;
    "") ;;
    *)
      usage >&2
      exit 2
      ;;
  esac
  if [ "$(id -u)" != 0 ]; then
    echo "portikus: setup must run as root: sudo portikus setup" >&2
    exit 1
  fi
  if [ ! -r "${CONFIG_FILE}" ]; then
    echo "portikus: ${CONFIG_FILE} is missing; run: sudo dpkg-reconfigure portikus" >&2
    exit 1
  fi
  set -- -e "@${CONFIG_FILE}"
  if [ -r "${SECRETS_FILE}" ]; then
    set -- "$@" -e "@${SECRETS_FILE}"
  fi
  # ansible.cfg is read from the working directory.
  cd "${ANSIBLE_DIR}"
  ANSIBLE_COLLECTIONS_PATH="${ANSIBLE_DIR}/collections" \
    exec ansible-playbook -i "${ANSIBLE_DIR}/inventory-local.ini" "$@" site.yml
}

status() {
  echo "portikus $(dpkg-query -W -f '${Version}' portikus 2>/dev/null || echo unknown)"
  echo "node $("${NODE}" --version 2>/dev/null || echo missing)"
  for unit in ${UNITS}; do
    printf '%-28s %s\n' "${unit}" "$(systemctl is-active "${unit}" 2>/dev/null || true)"
  done
}

# The host's backup timer calls this over SSH (SPEC.md section 24.9, ADR 0040).
backup_channel() {
  if [ "$(id -u)" != 0 ]; then
    echo "portikus: backup-channel must run as root: sudo portikus backup-channel ${1:-}" >&2
    exit 1
  fi
  case "${1:-}" in
    pull | report) ;;
    *)
      usage >&2
      exit 2
      ;;
  esac
  # The worker's own settings, parsed as systemd parses them for the worker.
  exec systemd-run --wait --pipe --quiet --collect --uid=portikus \
    -p EnvironmentFile="${WORKER_ENV}" \
    "${NODE}" "${BACKUP_CHANNEL_MAIN}" "$1"
}

reset_admin() {
  if [ "$(id -u)" != 0 ]; then
    echo "portikus: reset-admin must run as root: sudo portikus reset-admin" >&2
    exit 1
  fi
  if ! grep -q '^DEX_GRPC_ADDR=' "${API_ENV}" 2>/dev/null; then
    echo "portikus: ${API_ENV} names no DEX_GRPC_ADDR, so this site has no Dex local passwords" >&2
    exit 2
  fi

  # The password reaches only this root-only file, never a log or the journal.
  umask 077
  tmp="$(mktemp "${PASSWORD_FILE}.XXXXXX")"
  trap 'rm -f "${tmp}"' EXIT

  # The API's own settings, parsed as systemd parses them for the API.
  status=0
  systemd-run --wait --pipe --quiet --collect --uid=portikus \
    -p EnvironmentFile="${API_ENV}" \
    "${NODE}" "${RESET_ADMIN_MAIN}" "$@" >"${tmp}" || status=$?

  case "${status}" in
    0)
      if [ ! -s "${tmp}" ]; then
        echo "portikus: reset-admin printed no password; ${PASSWORD_FILE} is unchanged" >&2
        exit 1
      fi
      mv "${tmp}" "${PASSWORD_FILE}"
      echo "${READ_LINE}"
      ;;
    10)
      echo "The local administrator has not yet chosen its own password."
      if [ -e "${PASSWORD_FILE}" ]; then
        echo "${READ_LINE}"
      else
        echo "Its one-time password file is gone; make a new one with: sudo portikus reset-admin"
      fi
      exit 10
      ;;
    *)
      exit "${status}"
      ;;
  esac
}

case "${1:-}" in
  setup)
    shift
    setup "$@"
    ;;
  status)
    status
    ;;
  reset-admin)
    shift
    reset_admin "$@"
    ;;
  backup-channel)
    shift
    backup_channel "$@"
    ;;
  -h | --help | help)
    usage
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac
