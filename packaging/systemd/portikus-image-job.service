# Portikus workspace image job (docs/EPIC-15.md rulings 22 to 28, ADR 0030).
# Started by portikus-image-job.path for each request the API writes, and
# once at boot to mark a job the host lost as failed, so the admin page is
# never left waiting on it. It fetches, builds, activates or rolls back the
# workspace image.
[Unit]
Description=Portikus workspace image job
After=incus.service network-online.target
Wants=network-online.target
ConditionPathIsDirectory=/var/lib/portikus/image-jobs

[Service]
Type=oneshot
ExecStart=/usr/lib/portikus/image-job
# Runs however the job ended, even when killed at the timeout.
ExecStopPost=/usr/lib/portikus/image-job recover
# A build runs distrobuilder, about 20 minutes, longer on a slow mirror.
TimeoutStartSec=3h
# Student workspaces keep the CPU and disk while an image builds.
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7

# distrobuilder needs root with mounts, chroot and device nodes, and the
# health check needs the Incus socket, so the sandbox stops at what those
# allow. The request itself is only ever read as fixed kinds and choices.
UMask=0022
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=read-only
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
