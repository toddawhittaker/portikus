# Portikus Docker cache requests (the pattern of ADR 0030).
# The API writes request-<id>.json into the request directory; this starts
# the root cache helper, which takes every request before it exits.
[Unit]
Description=Portikus Docker cache requests

[Path]
PathExistsGlob=/var/lib/portikus/registry-jobs/request-*.json
Unit=portikus-registry-job.service

[Install]
WantedBy=paths.target
