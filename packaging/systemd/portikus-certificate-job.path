# Portikus site certificate job trigger (docs/SPEC.md sections 21.12 and
# 24.8, ADR 0046). The API writes request-<id>.json into the job directory;
# this starts the root job, which takes every request before it exits.
[Unit]
Description=Portikus site certificate job requests

[Path]
PathExistsGlob=/var/lib/portikus/certificate-jobs/request-*.json
Unit=portikus-certificate-job.service

[Install]
WantedBy=paths.target
