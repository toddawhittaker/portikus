# Portikus Docker Hub pull-through cache (issue #840, security ruling S1).
# Debian's docker-registry 2.8 in proxy mode on the workspace gateway only,
# 10.200.0.1:5000, storing on its own loop-file filesystem. Enabled by
# Ansible, which masks Debian's own docker-registry.service.
[Unit]
Description=Portikus Docker Hub pull-through cache
# The gateway address exists once Incus has made the bridge; the egress
# helper loads its gate on the cache ports first (ruling S2).
After=network-online.target incus.service portikus-egress-apply.service
Wants=network-online.target
RequiresMountsFor=/var/lib/portikus-registry
ConditionPathIsDirectory=/etc/portikus/registry

[Service]
Type=simple
User=portikus-registry
Group=portikus-registry
# As root: the config from the helper's state, and the storage directory.
ExecStartPre=+/usr/lib/portikus/registry-job render hub
ExecStart=/usr/bin/docker-registry serve /etc/portikus/registry/hub.yml
# The bridge may come up after this unit at boot.
Restart=always
RestartSec=5
MemoryMax=512M
TasksMax=256
UMask=0077

NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ReadWritePaths=/var/lib/portikus-registry
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
