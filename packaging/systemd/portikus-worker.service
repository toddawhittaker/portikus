# Portikus worker — shipped by the portikus Debian package.
[Unit]
Description=Portikus Worker
After=network.target postgresql.service portikus-controller.service portikus-api.service
Requires=postgresql.service
# A crash alerts the administrator straight from systemd (STACK.md section 15).
OnFailure=portikus-alert@%n.service
ConditionPathExists=/etc/portikus/worker.env

[Service]
Type=simple
# Its own account: the API's group opens the backup key socket (ADR 0044).
User=portikus-worker
Group=portikus-worker
EnvironmentFile=/etc/portikus/worker.env
# Where alerts go; missing until setup writes it (STACK.md section 15).
EnvironmentFile=-/etc/portikus/alerts.env
EnvironmentFile=-/etc/portikus/worker.override.env
ExecStart=/usr/lib/portikus/node/bin/node /usr/lib/portikus/worker/dist/index.js
Restart=on-failure
RestartSec=5
# Workspaces may together promise more memory than the VM has; when it runs
# out, the kernel kills workspace processes first.  The cap keeps a leak or
# a flood of requests from taking the VM instead (about 100 MiB measured; docs/CAPACITY.md).
OOMScoreAdjust=-900
MemoryMax=512M

# Hardening (SPEC section 24)
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
# The controller and the blocked-name counter's listeners are on 127.0.0.1;
# PostgreSQL is reached over its Unix socket.
IPAddressAllow=127.0.0.1
# The workspace bridge: the agent inside each container (SPEC.md 23.5).
IPAddressAllow=10.200.0.0/24
IPAddressDeny=any

[Install]
WantedBy=multi-user.target
