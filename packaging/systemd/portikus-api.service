# Portikus API — shipped by the portikus Debian package.
[Unit]
Description=Portikus API
After=network.target postgresql.service
Requires=postgresql.service
# A crash alerts the administrator straight from systemd (STACK.md section 15).
OnFailure=portikus-alert@%n.service
ConditionPathExists=/etc/portikus/api.env

[Service]
Type=simple
User=portikus
Group=portikus
# Reads the journal for the admin Logs tab; the API process only, not the
# portikus user, so the worker does not get it (docs/adr/0036).
SupplementaryGroups=systemd-journal
EnvironmentFile=/etc/portikus/api.env
# Where alerts go; missing until setup writes it (STACK.md section 15).
EnvironmentFile=-/etc/portikus/alerts.env
EnvironmentFile=-/etc/portikus/api.override.env
ExecStartPre=/usr/lib/portikus/node/bin/node /usr/lib/portikus/api/node_modules/@portikus/db/dist/migrate.js
ExecStart=/usr/lib/portikus/node/bin/node /usr/lib/portikus/api/dist/index.js
Restart=on-failure
RestartSec=5
# Workspaces may together promise more memory than the VM has; when it runs
# out, the kernel kills workspace processes first.  The cap keeps a leak or
# a flood of requests from taking the VM instead (about 110 MiB idle and 240 MiB at 25 workspaces; docs/CAPACITY.md).
# MemoryLow keeps its page cache from being reclaimed first under memory
# pressure (docs/CAPACITY.md).
OOMScoreAdjust=-900
MemoryMax=1G
MemoryLow=256M

# Hardening (SPEC section 24)
NoNewPrivileges=yes
ProtectSystem=strict
# Its only writes outside its own state: image job, Docker cache and
# certificate requests (ADRs 0030 and 0046). The leading "-" lets the API
# start on a host where a directory is not made yet.
ReadWritePaths=-/var/lib/portikus/image-jobs
ReadWritePaths=-/var/lib/portikus/registry-jobs
ReadWritePaths=-/var/lib/portikus/certificate-jobs
ProtectHome=yes
PrivateTmp=yes
# Loopback includes the egress proxy on 127.0.0.1:3128, the API's only way
# to a sign-in provider or LMS keyset; nothing else outside is allowed (ADR 0027).
IPAddressAllow=127.0.0.0/8
# The workspace bridge: the agent inside each container (SPEC.md 23.5).
IPAddressAllow=10.200.0.0/24
IPAddressDeny=any

[Install]
WantedBy=multi-user.target
