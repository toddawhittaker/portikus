# Portikus API — shipped by the portikus Debian package.
[Unit]
Description=Portikus API
After=network.target postgresql.service portikus-mock-idp.service
Requires=postgresql.service
ConditionPathExists=/etc/portikus/api.env

[Service]
Type=simple
User=portikus
Group=portikus
EnvironmentFile=/etc/portikus/api.env
EnvironmentFile=-/etc/portikus/api.override.env
ExecStartPre=/usr/bin/node /usr/lib/portikus/api/node_modules/@portikus/db/dist/migrate.js
ExecStart=/usr/bin/node /usr/lib/portikus/api/dist/index.js
Restart=on-failure
RestartSec=5
# Workspaces may together promise more memory than the VM has; when it runs
# out, the kernel kills workspace processes first (docs/CAPACITY.md).
OOMScoreAdjust=-900

# Hardening (SPEC section 24)
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
IPAddressAllow=127.0.0.0/8
# The workspace bridge: the agent inside each container (SPEC.md 23.5).
IPAddressAllow=10.200.0.0/24
IPAddressDeny=any

[Install]
WantedBy=multi-user.target
