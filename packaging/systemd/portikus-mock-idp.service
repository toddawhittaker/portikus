# Portikus mock identity provider — shipped by the portikus Debian package.
# Test only: the package never enables this unit, Ansible does when
# portikus_mock_idp is true (ADR 0008).
[Unit]
Description=Portikus mock identity provider (test only)
After=network.target
ConditionPathExists=/etc/portikus/mock-idp.env

[Service]
Type=simple
User=portikus
Group=portikus
EnvironmentFile=/etc/portikus/mock-idp.env
EnvironmentFile=-/etc/portikus/mock-idp.override.env
ExecStart=/usr/bin/node /usr/lib/portikus/api/node_modules/@portikus/auth/dist/testing/mock-oidc-main.js
Restart=on-failure
RestartSec=5
# Workspaces may together promise more memory than the VM has; when it runs
# out, the kernel kills workspace processes first (docs/CAPACITY.md).
OOMScoreAdjust=-900

# Hardening (SPEC section 24)
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
IPAddressAllow=127.0.0.0/8
IPAddressDeny=any

[Install]
WantedBy=multi-user.target
