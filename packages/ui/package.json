{
	"name": "@portikus/ui",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"sideEffects": [
		"./dist/theme.css",
		"./src/theme.css"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./theme.css": "./dist/theme.css"
	},
	"scripts": {
		"typecheck": "tsc -b",
		"build": "mkdir -p dist/primitives dist/overlays dist/fonts && cp src/theme.css dist/theme.css && cp src/primitives/primitives.css dist/primitives/primitives.css && cp src/overlays/overlays.css dist/overlays/overlays.css && cp src/fonts/*.woff2 dist/fonts/"
	},
	"dependencies": {
		"@dnd-kit/core": "6.3.1",
		"@dnd-kit/sortable": "10.0.0",
		"@dnd-kit/utilities": "3.2.2",
		"@radix-ui/react-alert-dialog": "1.2.1",
		"@radix-ui/react-context-menu": "2.4.1",
		"@radix-ui/react-dialog": "1.3.1",
		"@radix-ui/react-dropdown-menu": "2.2.1",
		"@radix-ui/react-popover": "1.3.1",
		"@radix-ui/react-select": "2.4.1",
		"@radix-ui/react-tabs": "1.2.1",
		"@radix-ui/react-toast": "1.3.1",
		"@radix-ui/react-tooltip": "1.4.1",
		"aria-hidden": "1.2.6",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"react-resizable-panels": "4.15.1"
	},
	"devDependencies": {
		"@testing-library/react": "16.3.3",
		"@types/node": "24.19.2",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0"
	}
}
